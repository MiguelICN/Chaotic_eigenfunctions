Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "phases", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"unfolded", "=", 
   RowBox[{"phases", "*", 
    RowBox[{"(", 
     RowBox[{"n", "/", 
      RowBox[{"(", 
       RowBox[{"2", "*", "Pi"}], ")"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spacings", "=", 
   RowBox[{"Differences", "[", "unfolded", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanSpacing", "=", 
   RowBox[{"Mean", "[", "spacings", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spacings", "=", 
   RowBox[{"spacings", "/", "meanSpacing"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979722527568865*^9, 3.9797225279044857`*^9}, {
   3.979729288487015*^9, 3.979729289061548*^9}, 3.983606014028225*^9, 
   3.9836064511357403`*^9, {3.9836071064563084`*^9, 3.9836071066904335`*^9}},
 CellLabel->
  "In[134]:=",ExpressionUUID->"42324c6b-7be8-db40-b709-c1f37b6a0ec7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"poisson", "[", "s_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", "s"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wignerDyson", "[", "s_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Pi", "*", 
      RowBox[{"s", "/", "2"}]}], ")"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"Pi", "*", 
         RowBox[{"s", "^", "2"}]}], ")"}]}], "/", "4"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[139]:=",ExpressionUUID->"c0c5c98a-5ecb-6c48-934b-5896208ad92c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Histogram", "[", 
    RowBox[{"spacings", ",", 
     RowBox[{"{", "0.1", "}"}], ",", "\"\<PDF\>\"", ",", 
