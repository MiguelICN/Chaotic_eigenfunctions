In[113]:=",ExpressionUUID->"d64847f0-8562-9642-8312-fcfa7015d07f"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1.", " ", "Fast"}], ",", 
    RowBox[{"Universal", " ", "Parity", " ", "Sector", " ", "Separation"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sx", "^", "2"}], " ", "strictly", " ", "couples", " ", "m", " ",
       "to", " ", "m"}], "\[PlusMinus]", "2"}], ",", 
    RowBox[{
    "meaning", " ", "alternating", " ", "array", " ", "indices", " ", 
     "ALWAYS", " ", 
     RowBox[{"decouple", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"IntegerQ", "[", "J", "]"}], "&&", 
      RowBox[{"OddQ", "[", "J", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "If", " ", "J", " ", "is", " ", "an", " ", "odd", " ", "integer"}], ",", 
       RowBox[{"the", " ", "highest", " ", "m", " ", 
        RowBox[{"(", 
         RowBox[{"index", " ", "1"}], ")"}], " ", "is", " ", 
        RowBox[{"odd", ".", "Thus"}]}], ",", 
       RowBox[{
       "index", " ", "2", " ", "starts", " ", "the", " ", "Even", " ", "m", " ", 
        RowBox[{"sector", "."}]}]}], "*)"}], 
     RowBox[{
      RowBox[{"idxEvenM", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"2", ",", "d", ",", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"idxOddM", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "d", ",", "2"}], "]"}]}], ";"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "If", " ", "J", " ", "is", " ", "an", " ", "even", " ", "integer"}], ",", 
       RowBox[{"the", " ", "highest", " ", "m", " ", 
        RowBox[{"(", 
         RowBox[{"index", " ", "1"}], ")"}], " ", "is", " ", 
        RowBox[{"even", "."}]}]}], "*)"}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{"If", " ", "J", " ", "is", " ", "a", " ", "half"}], "-", 
        "integer"}], ",", 
       RowBox[{"'", 
        RowBox[{"Even", "/", 
         RowBox[{"Odd", "'"}]}], " ", "m", " ", 
        RowBox[{"doesn", "'"}], "t", " ", "exist"}], ",", 
       RowBox[{"so", " ", "we", " ", "default", " ", "to", " ", "standard", " ", 
        RowBox[{"decoupling", "."}]}]}], "*)"}], 
     RowBox[{
      RowBox[{"idxEvenM", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "d", ",", "2"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"idxOddM", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"2", ",", "d", ",", "2"}], "]"}]}], ";"}]}], "]"}], 
   ";"}]}]], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"fe0215d2-9692-d648-9180-7ea83816aac0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "Extract", " ", "the", " ", "submatrices", " ", "based", " ", 
    "on", " ", "the", " ", "physical", " ", "indices"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"matEven", "=", 
     RowBox[{"mat", "[", 
      RowBox[{"[", 
       RowBox[{"idxEvenM", ",", "idxEvenM"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"matOdd", "=", 
     RowBox[{"mat", "[", 
      RowBox[{"[", 
       RowBox[{"idxOddM", ",", "idxOddM"}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"ae8b891a-e0f8-634f-bf7d-ae01422a12cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"3.", " ", "Diagonalize", " ", "both", " ", "sectors"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eigenvalEven", ",", "eigenvecEven"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", 
      RowBox[{"matEven", ",", 
       RowBox[{"Method", "->", "\"\<Direct\>\""}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eigenvalOdd", ",", "eigenvecOdd"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", 
      RowBox[{"matOdd", ",", 
       RowBox[{"Method", "->", "\"\<Direct\>\""}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"a9a81d30-a16b-bd41-acc7-b5a5001ac0b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Reconstruct", " ", "full", " ", "eigenvectors", " ", 
    "robustly"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"neweigenvecEven", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"vec", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", "d"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vec", "[", 
          RowBox[{"[", "idxEvenM", "]"}], "]"}], "=", 
         RowBox[{"eigenvecEven", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "vec"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "idxEvenM", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"neweigenvecOdd", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"vec", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.", ",", "d"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"vec", "[", 
          RowBox[{"[", "idxOddM", "]"}], "]"}], "=", 
         RowBox[{"eigenvecOdd", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "vec"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", "idxOddM", "]"}]}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"fbd640c4-3377-b943-a429-9b295de63f2f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"5.", " ", "Combine", " ", "the", " ", "final", " ", "spectrum"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"neweigenvec", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"neweigenvecEven", ",", "neweigenvecOdd"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"neweigenval", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"eigenvalEven", ",", "eigenvalOdd"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983607351805313*^9, 3.983607409220495*^9}},
 CellLabel->
  "In[127]:=",ExpressionUUID->"69a220fa-3755-bc41-8bfe-e17f568dc901"],

