f9f248dd24f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<Computing Floquet matrix...\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"J", "=", 
   RowBox[{"1001", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Alpha]", "=", 
   RowBox[{"Pi", "/", "2."}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k", "=", "10."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "mat", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mat", "=", 
   RowBox[{"Floq", "[", 
    RowBox[{"J", ",", "\[Alpha]", ",", "k"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d", "=", 
   RowBox[{
    RowBox[{"2", " ", "J"}], "+", "1"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.983607365940386*^9, 3.983607366275738*^9}, {
  3.983607422407156*^9, 3.9836074230893764`*^9}, {3.983607465189026*^9, 
  3.9836074667520027`*^9}},
 CellLabel->
  "In[113]:=",ExpressionUUID->"95ee70ca-7077-3b4d-99b1-219c5b6abd3a"],

Cell[BoxData["\<\"Computing Floquet matrix...\"\>"], "Print",
 CellChangeTimes->{3.983607366581175*^9, 3.983607424319725*^9, 
  3.9836074682923985`*^9},
 CellLabel->
