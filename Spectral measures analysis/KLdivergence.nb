      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sx2Vals", ",", " ", "sx2Vecs"}], "}"}], " ", "=", " ", 
