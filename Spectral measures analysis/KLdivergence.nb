Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", " ", 
    RowBox[{"WORKER", " ", 
     RowBox[{"FUNCTIONS", ":", " ", 
      RowBox[{
       RowBox[{"defined", " ", "on", " ", "all", " ", "kernels"}], " ", 
       "==="}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"ParallelEvaluate", "[", "\n", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"EmpBinProb", "[", "ratios_List", "]"}], " ", ":=", "\n", 
      "    ", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"BinCounts", "[", 
         RowBox[{"ratios", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "1", ",", " ", "binWidth"}], "}"}]}], "]"}],
         "]"}], " ", "/", " ", 
       RowBox[{"Length", "[", "ratios", "]"}]}]}], ";", "\n", "\n", "  ", 
     RowBox[{
      RowBox[{"SpacingRatios", "[", "spectrum_List", "]"}], " ", ":=", "\n", 
      "    ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sp", " ", "=", " ", 
          RowBox[{"Differences", "[", "spectrum", "]"}]}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"Min", " ", "/@", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Most", "[", "sp", "]"}], "/", 
             RowBox[{"Rest", "[", "sp", "]"}]}], ",", " ", 
            RowBox[{
             RowBox[{"Rest", "[", "sp", "]"}], "/", 
             RowBox[{"Most", "[", "sp", "]"}]}]}], "}"}], "]"}]}]}], "]"}]}], 
     ";", "\n", "\n", "  ", 
     RowBox[{
      RowBox[{"KLDiv", "[", 
       RowBox[{"p_List", ",", " ", "q_List"}], "]"}], " ", ":=", "\n", "    ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"eps", " ", "=", " ", "1.*^-14"}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"Total", " ", "@", " ", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#1", " ", "<", " ", "eps"}], ",", " ", "0.", ",", " ", 
              RowBox[{"#1", " ", "*", " ", 
               RowBox[{"Log", "[", 
                RowBox[{"#1", "/", 
                 RowBox[{"Max", "[", 
                  RowBox[{"#2", ",", " ", "eps"}], "]"}]}], "]"}]}]}], "]"}], 
            " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"p", ",", " ", "q"}], "}"}]}], "]"}]}]}], "]"}]}], ";", 
     "\n", "\n", "  ", 
     RowBox[{
      RowBox[{"ComputeKLAtK", "[", 
       RowBox[{"k_", "?", "NumericQ"}], "]"}], " ", ":=", "\n", "    ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "sectors", ",", " ", "eigsE", ",", " ", "eigsO", ",", " ", "phE", ",",
           " ", "phO", ",", " ", "specE", ",", " ", "specO", ",", "\n", 
          "            ", "rE", ",", " ", "rO", ",", " ", "rAll", ",", " ", 
          "pE", ",", " ", "pO", ",", " ", "pAll"}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Eigenvalues", " ", "of", " ", "the", " ", "two", " ", "parity", " ",
           "sectors"}], " ", "*)"}], "\n", "      ", 
        RowBox[{
         RowBox[{"sectors", " ", "=", " ", 
          RowBox[{"FloqSectorFast", "[", "k", "]"}]}], ";", "\n", "      ", 
         RowBox[{"eigsE", " ", "=", " ", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"sectors", "[", "\"\<Even\>\"", "]"}], ",", " ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]}], "]"}]}], ";",
          "\n", "      ", 
         RowBox[{"eigsO", " ", "=", " ", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"sectors", "[", "\"\<Odd\>\"", "]"}], ",", "  ", 
            RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]}], "]"}]}], ";",
          "\n", "      ", 
         RowBox[{"(*", " ", 
          RowBox[{"Unfolded", " ", "spectra", " ", 
           RowBox[{"(", 
            RowBox[{
            "replicates", " ", "UnfoldLinear", " ", "logic", " ", "inline"}], 
            ")"}]}], " ", "*)"}], "\n", "      ", 
         RowBox[{"phE", " ", "=", " ", 
          RowBox[{"Sort", "[", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"Arg", "[", "eigsE", "]"}], ",", " ", 
             RowBox[{"2", " ", "Pi"}]}], "]"}], "]"}]}], ";", "\n", "      ", 
         RowBox[{"phO", " ", "=", " ", 
          RowBox[{"Sort", "[", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"Arg", "[", "eigsO", "]"}], ",", " ", 
             RowBox[{"2", " ", "Pi"}]}], "]"}], "]"}]}], ";", "\n", "      ", 
         RowBox[{"specE", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Length", "[", "phE", "]"}], " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], " ", "*", " ", 
           "phE"}]}], ";", "\n", "      ", 
         RowBox[{"specO", " ", "=", " ", 
          RowBox[{
           RowBox[{"(", 
