Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", " ", "PLOT", " ", "==="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"kVals", " ", "=", " ", 
     RowBox[{"klResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "\"\<k\>\""}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"pOpts", " ", "=", " ", 
     RowBox[{"Sequence", "[", 
      RowBox[{
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"ImageSize", " ", "->", " ", "900"}], ",", "\n", "  ", 
       RowBox[{"FrameStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", " ", "20"}], "]"}]}], ",", " ", 
       RowBox[{"LabelStyle", " ", "->", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", " ", "18"}], "]"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"plt", " ", "=", " ", 
     RowBox[{"Legended", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"kVals", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], " ", 
          "/@", " ", 
          RowBox[{"{", "\n", "      ", 
           RowBox[{
            RowBox[{"klResults", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "\"\<KL_E_COE\>\""}], "]"}], "]"}], ",",
