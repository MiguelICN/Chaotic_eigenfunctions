             RowBox[{"\"\<Spectrum\>\"", " ", "->", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"nO", " ", "/", " ", 
                 RowBox[{"(", 
                  RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], " ", "phO"}]}], ",",
              " ", 
             RowBox[{"\"\<N\>\"", " ", "->", " ", "nO"}]}], "|>"}]}]}], 
         "|>"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Parallel", " ", "ensemble", " ", "using", " ", "fast", " ", "Floquet", " ",
      "construction"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GenerateEnsembleFast", "[", "kEns_List", "]"}], " ", ":=", "\n",
      "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "allSpec", "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"DistributeDefinitions", "[", 
