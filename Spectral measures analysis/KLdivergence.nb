      RowBox[{"N", "[", "sx2", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sx2VecsT", " ", "=", " ", 
     RowBox[{"Transpose", "[", "sx2Vecs", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"freeVec", "  ", "=", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", "alpha", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"J", ",", " ", 
         RowBox[{"-", "J"}], ",", " ", 
         RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"idx", "      ", "=", " ", 
     RowBox[{"ParitySectorIndices", "[", "J", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"TwistFast", "[", 
      RowBox[{"k_", "?", "NumericQ"}], "]"}], " ", ":=", "\n", "  ", 
     RowBox[{"sx2VecsT", " ", ".", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"k", " ", "/", " ", 
             RowBox[{"(", 
              RowBox[{"2.", " ", "J"}], ")"}]}]}], ")"}], " ", "sx2Vals"}], 
         "]"}], " ", "*", " ", "sx2Vecs"}], ")"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"FloqSectorFast", "[", 
      RowBox[{"k_", "?", "NumericQ"}], "]"}], " ", ":=", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"T", " ", "=", " ", 
          RowBox[{"TwistFast", "[", "k", "]"}]}], ",", " ", 
         RowBox[{"idxE", " ", "=", " ", 
          RowBox[{"idx", "[", "\"\<Even\>\"", "]"}]}], ",", " ", 
         RowBox[{"idxO", " ", "=", " ", 
          RowBox[{"idx", "[", "\"\<Odd\>\"", "]"}]}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Even\>\"", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"T", "[", 
             RowBox[{"[", 
              RowBox[{"idxE", ",", " ", "idxE"}], "]"}], "]"}], " ", "*", " ", 
            RowBox[{"freeVec", "[", 
             RowBox[{"[", "idxE", "]"}], "]"}]}], ")"}]}], ",", "\n", 
         "      ", 
         RowBox[{"\"\<Odd\>\"", "  ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"T", "[", 
             RowBox[{"[", 
              RowBox[{"idxO", ",", " ", "idxO"}], "]"}], "]"}], " ", "*", " ", 
            RowBox[{"freeVec", "[", 
             RowBox[{"[", "idxO", "]"}], "]"}]}], ")"}]}]}], "|>"}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GetSpectraFast", "[", 
