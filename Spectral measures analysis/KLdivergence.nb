 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", " ", "EXPORT", " ", "==="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"outDir", " ", "=", " ", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<Results\>\"", 
        ",", " ", "\"\<KL_Ps\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", "outDir", "]"}]}], ",", " ", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"outDir", ",", " ", 
        RowBox[{"CreateIntermediateDirectories", " ", "->", " ", "True"}]}], 
       "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"outDir", ",", " ", "\"\<kl_Ps_vs_k.wdx\>\""}], "}"}], "]"}], 
      ",", " ", "klResults", ",", " ", "\"\<WDX\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Saved.\>\"", "]"}], ";"}]}]}]], "Input",
