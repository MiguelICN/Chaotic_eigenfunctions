     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "sectors", ",", " ", "eigsE", ",", " ", "eigsO", ",", " ", "phE", ",",
          " ", "phO", ",", " ", "nE", ",", " ", "nO"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"sectors", " ", "=", " ", 
         RowBox[{"FloqSectorFast", "[", "k", "]"}]}], ";", "\n", "    ", 
        RowBox[{"eigsE", "   ", "=", " ", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{
           RowBox[{"sectors", "[", "\"\<Even\>\"", "]"}], ",", " ", 
           RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{"eigsO", "   ", "=", " ", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{
           RowBox[{"sectors", "[", "\"\<Odd\>\"", "]"}], ",", "  ", 
           RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{"phE", " ", "=", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"Arg", "[", "eigsE", "]"}], ",", " ", 
            RowBox[{"2", " ", "Pi"}]}], "]"}], "]"}]}], ";", " ", 
        RowBox[{"nE", " ", "=", " ", 
         RowBox[{"Length", "[", "phE", "]"}]}], ";", "\n", "    ", 
        RowBox[{"phO", " ", "=", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"Arg", "[", "eigsO", "]"}], ",", " ", 
            RowBox[{"2", " ", "Pi"}]}], "]"}], "]"}]}], ";", " ", 
        RowBox[{"nO", " ", "=", " ", 
         RowBox[{"Length", "[", "phO", "]"}]}], ";", "\n", "    ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Even\>\"", " ", "->", " ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Spectrum\>\"", " ", "->", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"nE", " ", "/", " ", 
                 RowBox[{"(", 
                  RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], " ", "phE"}]}], ",",
              " ", 
             RowBox[{"\"\<N\>\"", " ", "->", " ", "nE"}]}], "|>"}]}], ",", 
          "\n", "      ", 
          RowBox[{"\"\<Odd\>\"", "  ", "->", " ", 
           RowBox[{"<|", 
