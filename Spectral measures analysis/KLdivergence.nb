          RowBox[{"{", 
           RowBox[{"All", ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "Automatic"}], "}"}]}], "}"}]}]}], "]"}], 
       ",", "\n", "  ", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"LineLegend", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"Blue", ",", " ", "Thick"}], "]"}], ",", " ", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Thick"}], 
              "]"}], ",", "\n", "     ", 
             RowBox[{"Directive", "[", 
              RowBox[{"Red", ",", " ", "Thick"}], "]"}], ",", "  ", 
             RowBox[{"Directive", "[", 
              RowBox[{"Black", ",", " ", "Thick", ",", " ", "Dashed"}], 
              "]"}]}], "}"}], ",", "\n", "    ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Even \[DoubleVerticalBar] COE\>\"", ",", 
             " ", "\"\<Odd \[DoubleVerticalBar] COE\>\"", ",", "\n", 
             "     ", "\"\<Pooled \[DoubleVerticalBar] COE\>\"", ",", 
             " ", "\"\<Pooled \[DoubleVerticalBar] Poisson\>\""}], "}"}], ",",
            "\n", "    ", 
           RowBox[{"LabelStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", " ", "16"}], "]"}]}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
