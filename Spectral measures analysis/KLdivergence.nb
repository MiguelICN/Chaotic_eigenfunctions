              RowBox[{"All", ",", " ", "\"\<KL_All_COE\>\""}], "]"}], "]"}], ",",
             "\n", "      ", 
            RowBox[{"klResults", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "\"\<KL_All_Pois\>\""}], "]"}], 
             "]"}]}], "}"}]}], ",", "\n", "    ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{"Blue", ",", " ", "Thick"}], "]"}], ",", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{
              RowBox[{"Darker", "[", "Green", "]"}], ",", " ", "Thick"}], 
