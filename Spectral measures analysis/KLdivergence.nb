            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", " ", "Thick", ",", " ", "Dashed"}], 
             "]"}]}], "}"}]}], ",", "\n", "    ", "pOpts", ",", "\n", "    ", 
         RowBox[{"FrameLabel", " ", "->", " ", 
          RowBox[{"{", 
           
           RowBox[{"\"\<k\>\"", ",", 
            " ", "\"\<KL(P(s) \[DoubleVerticalBar] \
P\\[Sub]ref\\[Sub](s))\>\""}], "}"}]}], ",", "\n", "    ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"\"\<KL divergence of P(s),  J=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "J", "]"}], " ", "<>", "\n", 
           "                 ", "\"\<,  \[Alpha]=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "alpha", "]"}], " ", "<>", "\n", 
           "                 ", "\"\<,  M=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "nReal", "]"}]}]}], ",", "\n", "    ", 
