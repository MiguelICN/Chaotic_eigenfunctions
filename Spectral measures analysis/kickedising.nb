Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"computeAWedgeB", "[", 
     RowBox[{"diagE_", ",", " ", "tau_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"Length", "[", "diagE", "]"}]}], ",", " ", "phases", ",", 
        " ", "a", ",", " ", "b"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"phases", " ", "=", " ", 
        RowBox[{"tau", " ", "*", " ", 
         RowBox[{"diagE", " ", "/", " ", "2"}]}]}], ";", "\n", "  ", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{
         RowBox[{"Cos", "[", "phases", "]"}], " ", "/", " ", 
         RowBox[{"Sqrt", "[", "d", "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{
