Cell[BoxData[
 RowBox[{
  RowBox[{"EntanglementEntropySVD", "[", 
   RowBox[{"psi_", ",", " ", "dA_", ",", " ", "dB_"}], "]"}], " ", ":=", "\n",
   "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mat", ",", " ", "sv2"}], "}"}], ",", "\n", "    ", 
    RowBox[{
     RowBox[{"mat", " ", "=", " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{"psi", ",", " ", 
        RowBox[{"{", 
         RowBox[{"dA", ",", " ", "dB"}], "}"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"sv2", " ", "=", " ", 
      RowBox[{
       RowBox[{"SingularValueList", "[", "mat", "]"}], "^", "2"}]}], ";", 
     "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Hard", " ", "threshold", " ", "at", " ", "machine", " ", "epsilon", " ",
        "level"}], " ", "*)"}], "\n", "    ", 
     RowBox[{"sv2", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"sv2", ",", " ", 
        RowBox[{
         RowBox[{"#", " ", ">", " ", "1.*^-14"}], " ", "&"}]}], "]"}]}], ";", 
     "\n", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Renormalize", " ", "to", " ", "absorb", " ", "discarded", " ", 
       "numerical", " ", "noise"}], " ", "*)"}], "\n", "    ", 
     RowBox[{"sv2", " ", "=", " ", 
      RowBox[{"sv2", " ", "/", " ", 
       RowBox[{"Total", "[", "sv2", "]"}]}]}], ";", "\n", "    ", 
     RowBox[{"-", 
      RowBox[{"sv2", " ", ".", " ", 
       RowBox[{"Log", "[", "sv2", "]"}]}]}]}]}], "\n", "  ", "]"}]}]], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"9a521865-c604-a941-a42c-c215996ae661"],

