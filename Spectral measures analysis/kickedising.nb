Cell[CellGroupData[{

Cell["sectors", "Title",
 CellChangeTimes->{{3.9881303136459236`*^9, 
  3.988130315416954*^9}},ExpressionUUID->"285143dd-18d4-1b47-885c-\
3fc1bc487c19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{"Reflection", "-", 
    RowBox[{"sector", " ", "diagonalization"}]}], 
   "                            ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Build", " ", "orthonormal", " ", "bases", " ", "for", " ", "P"}],
     "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], " ", "sectors", " ", "explicitly"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"buildSectorBases", "[", "L_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dim", " ", "=", " ", 
          RowBox[{"2", "^", "L"}]}], ",", " ", "refl", ",", " ", 
         RowBox[{"evenB", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"oddB", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "seen", ",", " ", "r"}], "}"}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"refl", "[", "k_", "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", 
             RowBox[{"IntegerDigits", "[", 
              RowBox[{
               RowBox[{"k", " ", "-", " ", "1"}], ",", " ", "2", ",", " ", 
               "L"}], "]"}], "]"}], ",", " ", "2"}], "]"}], " ", "+", " ", 
          "1"}]}], ";", "\n", "  ", 
        RowBox[{"seen", " ", "=", " ", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"False", ",", " ", "dim"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"Do", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", " ", 
             RowBox[{"seen", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", "\n", "     ", 
            RowBox[{
             RowBox[{"r", " ", "=", " ", 
              RowBox[{"refl", "[", "i", "]"}]}], ";", "\n", "     ", 
             RowBox[{
              RowBox[{"seen", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", "True"}], ";", 
             " ", 
             RowBox[{
              RowBox[{"seen", "[", 
               RowBox[{"[", "r", "]"}], "]"}], " ", "=", " ", "True"}], ";", 
             "\n", "     ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"i", " ", "==", " ", "r"}], ",", "\n", "      ", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"evenB", ",", " ", 
                 RowBox[{"SparseArray", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"i", " ", "->", " ", "1."}], "}"}], ",", " ", 
                   "dim"}], "]"}]}], "]"}], ",", "\n", "      ", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"evenB", ",", " ", 
                  RowBox[{"SparseArray", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"i", " ", "->", " ", 
                    RowBox[{"1.", "/", 
                    RowBox[{"Sqrt", "[", "2.", "]"}]}]}], ",", " ", 
                    RowBox[{"r", " ", "->", " ", 
                    RowBox[{"1.", "/", 
                    RowBox[{"Sqrt", "[", "2.", "]"}]}]}]}], "}"}], ",", " ", 
                    "dim"}], "]"}]}], "]"}], ";", "\n", "      ", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"oddB", ",", "  ", 
                  RowBox[{"SparseArray", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"i", " ", "->", " ", 
                    RowBox[{"1.", "/", 
                    RowBox[{"Sqrt", "[", "2.", "]"}]}]}], ",", " ", 
                    RowBox[{"r", " ", "->", " ", 
                    RowBox[{
                    RowBox[{"-", "1."}], "/", 
                    RowBox[{"Sqrt", "[", "2.", "]"}]}]}]}], "}"}], ",", " ", 
                    "dim"}], "]"}]}], "]"}]}]}], "\n", "      ", "]"}]}]}], 
