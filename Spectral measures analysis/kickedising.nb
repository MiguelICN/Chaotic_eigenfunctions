       RowBox[{"#1", "/", "#2"}], ",", 
       RowBox[{"#2", "/", "#1"}]}], "]"}], "&"}], "@@@", 
    RowBox[{"Partition", "[", 
     RowBox[{"spacings", ",", "2", ",", "1"}], "]"}]}]}], ";"}], "\n", 
