     RowBox[{
      RowBox[{"D", " ", "=", " ", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "theta", " ", "diagHz"}], "]"}], "]"}]}], ";",
       "\n", "  ", 
      RowBox[{"U", " ", "=", " ", 
       RowBox[{"D", " ", ".", " ", "UFsym", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "D", "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"V", " ", "=", " ", 
       RowBox[{"Eigenvectors", "[", "U", "]"}]}], ";", "\n", "  ", 
      RowBox[{"P", " ", "=", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"V", " ", ".", " ", "f1"}], "]"}], "^", "2"}]}], ";", "\n", 
      "  ", 
      RowBox[{"dim", " ", "*", " ", 
       RowBox[{"Total", "[", 
        RowBox[{"P", "^", "2"}], "]"}]}]}]}], "\n", "]"}]}], ";"}]], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"4fe5c5d3-f209-3247-8b80-5127f92a71cd"],

