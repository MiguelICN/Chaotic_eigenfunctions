          RowBox[{"0", ",", " ", "tMax"}], "]"}]}], ",", " ", "allTex"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"DistributeDefinitions", "[", 
        RowBox[{"tGrid", ",", " ", "f1"}], "]"}], ";", "\n", "  ", 
       RowBox[{"allTex", " ", "=", " ", 
        RowBox[{"ParallelTable", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ph", " ", "=", " ", 
               RowBox[{"ensembleList", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "\"\<Phases\>\""}], "]"}], "]"}]}], ",", 
              " ", 
              RowBox[{"vecs", " ", "=", " ", 
               RowBox[{"ensembleList", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "\"\<Vectors\>\""}], "]"}], "]"}]}], ",", 
              " ", "\n", "            ", "d", ",", " ", "pArr"}], "}"}], ",", 
            "\n", "      ", 
            RowBox[{
             RowBox[{"d", " ", "=", " ", 
              RowBox[{"Length", "[", "ph", "]"}]}], ";", "\n", "      ", 
             RowBox[{"pArr", " ", "=", " ", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"Conjugate", "[", "vecs", "]"}], " ", ".", " ", 
                 "f1"}], "]"}], "^", "2"}]}], ";", "\n", "      ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"d", " ", "*", " ", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"Total", "[", 
                   RowBox[{"pArr", " ", "*", " ", 
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "I"}], " ", "t", " ", "ph"}], "]"}]}], "]"}],
                   "]"}], "^", "2"}]}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"t", ",", " ", "tGrid"}], "}"}]}], "]"}]}]}], "\n", 
           "    ", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "nMat"}], "}"}], ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<CoarsestGrained\>\""}]}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Time\>\"", " ", "->", " ", "tGrid"}], ",", " ", 
         RowBox[{"\"\<AllTex\>\"", " ", "->", " ", "allTex"}], ",", " ", 
         RowBox[{"\"\<MeanTex\>\"", " ", "->", " ", 
          RowBox[{"Mean", "[", "allTex", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}],
    ";"}]}]], "Input",
