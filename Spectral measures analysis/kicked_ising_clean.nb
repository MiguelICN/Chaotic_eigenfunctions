Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{"Reflection", "-", 
    RowBox[{"sector", " ", "diagonalization"}]}], 
   "                            ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Build", " ", "orthonormal", " ", "bases", " ", "for", " ", "P"}],
     "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "1"}], " ", "sectors", " ", "explicitly"}]}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"buildSectorBases", "[", "L_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"dim", " ", "=", " ", 
          RowBox[{"2", "^", "L"}]}], ",", " ", "refl", ",", " ", 
         RowBox[{"evenB", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ",", " ", 
         RowBox[{"oddB", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "seen", ",", " ", "r"}], "}"}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"refl", "[", "k_", "]"}], " ", ":=", " ", 
         RowBox[{
          RowBox[{"FromDigits", "[", 
           RowBox[{
            RowBox[{"Reverse", "[", 
