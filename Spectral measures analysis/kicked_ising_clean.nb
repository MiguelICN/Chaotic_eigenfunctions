Cell[BoxData[{
 RowBox[{
  RowBox[{"tMaxTex", " ", "=", " ", "2000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sigmaSm", " ", "=", " ", "10"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Computing texture \[LongDash] Even sector...\>\"", "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"texE", " ", "=", " ", 
   RowBox[{"EnsembleTexSector", "[", 
    RowBox[{
