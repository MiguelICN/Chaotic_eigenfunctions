   RowBox[{
    RowBox[{"plotR", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"expCDFR", "[", "x", "]"}], ",", 
         RowBox[{"theoCDFR", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
