      RowBox[{"string", ":", "10."}]}], "->", "\"\<10.0\>\""}], ",", 
    RowBox[{"10.5", "->", "\"\<10.5\>\""}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kStr", "[", "k_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
