Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "DATA", " ", "EXTRACTION", " ", "AND", " ", "UNFOLDING"}], 
   "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"phases", "=", 
     RowBox[{
      RowBox[{"qktEnsemble", "[", 
       RowBox[{"[", "\"\<Odd\>\"", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Nlevels", "=", 
     RowBox[{"Length", "[", "phases", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawSpacings", "=", 
     RowBox[{"Differences", "[", "phases", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"rawSpacings", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "Pi"}], "-", 
         RowBox[{"Last", "[", "phases", "]"}]}], ")"}], "+", 
       RowBox[{"First", "[", "phases", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"meanSpacing", "=", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "/", "Nlevels"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sVals", "=", 
     RowBox[{"rawSpacings", "/", "meanSpacing"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rVals", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"sVals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"sVals", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"i", ",", "Nlevels"}], "]"}], "+", "1"}], "]"}], 
           "]"}]}], "]"}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"sVals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"sVals", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"i", ",", "Nlevels"}], "]"}], "+", "1"}], "]"}], 
           "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nlevels"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9830040358558865`*^9, 3.9830040386393013`*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"2a8f096a-fbdb-6044-b8d9-7c66d6604a8f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "2.", " ", "DEFINE", " ", "EMPIRICAL", " ", "AND", " ", "THEORETICAL", " ",
     "CURVES"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"distS", "=", 
     RowBox[{"EmpiricalDistribution", "[", "sVals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"distR", "=", 
     RowBox[{"EmpiricalDistribution", "[", "rVals", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"expCDFS", "[", "x_", "]"}], ":=", 
     RowBox[{"CDF", "[", 
      RowBox[{"distS", ",", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"expCDFR", "[", "x_", "]"}], ":=", 
     RowBox[{"CDF", "[", 
      RowBox[{"distR", ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Theoretical", " ", "P", 
     RowBox[{"(", "s", ")"}], " ", "and", " ", "I", 
     RowBox[{
      RowBox[{"(", "s", ")"}], "[", 
      RowBox[{"Wigner", "/", "GOE"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"theoPDFS", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pi", "/", "2"}], ")"}], "*", "x", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "4"}], ")"}]}], "*", 
        RowBox[{"x", "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"theoCDFS", "[", "x_", "]"}], ":=", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "4"}], ")"}]}], "*", 
        RowBox[{"x", "^", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Atas", " ", "et", " ", 
     RowBox[{"al", ".", "distribution"}], " ", "for", " ", "the", " ", 
     "bounded", " ", "gap", " ", "ratio", " ", "r"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"theoPDFR", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"27", "/", "8"}], ")"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "+", 
         RowBox[{"x", "^", "2"}]}], ")"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "x", "+", 
          RowBox[{"x", "^", "2"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"5", "/", "2"}], ")"}]}]}]}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Add", " ", "Assumptions", " ", "to", " ", "prevent", " ", 
     "ConditionalExpression", " ", "outputs"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"theoCDFR", "[", "x_", "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"theoPDFR", "[", "r", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "0", ",", "x"}], "}"}]}], "]"}], ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"x", ">", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"msdDiffS", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"expCDFS", "[", "x", "]"}], "-", 
        RowBox[{"theoCDFS", "[", "x", "]"}]}], ")"}], "^", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cvmDiffS", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"expCDFS", "[", "x", "]"}], "-", 
         RowBox[{"theoCDFS", "[", "x", "]"}]}], ")"}], "^", "2"}], "*", 
      RowBox[{"theoPDFS", "[", "x", "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"msdDiffR", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"expCDFR", "[", "x", "]"}], "-", 
        RowBox[{"theoCDFR", "[", "x", "]"}]}], ")"}], "^", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"cvmDiffR", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
