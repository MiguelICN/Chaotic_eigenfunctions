        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Black", ",", "Thick"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Experimental I(r)\>\"", ",", "\"\<GOE/COE I(r)\>\""}], 
         "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Gap Ratio r\>\"", 
          ",", "\"\<Cumulative Probability I(r)\>\""}], "}"}]}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "20"}], "]"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Integrated Adjacent Gap Ratio\>\""}], ",", 
       RowBox[{"ImageSize", "->", "800"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983000218381977*^9, 3.983000222273197*^9}, {
