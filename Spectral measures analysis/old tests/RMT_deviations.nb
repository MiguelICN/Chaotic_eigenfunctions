Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "upper", " ", "limit", " ", "as", " ",
     "before"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxIntegrationLimit", "=", 
     RowBox[{
      RowBox[{"Max", "[", "sVals", "]"}], "+", "2"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Create", " ", "a", " ", "very", " ", "dense", " ", "grid", " ",
      "of", " ", "points", " ", "to", " ", "evaluate", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"e", ".", "g", "."}], ",", 
       RowBox[{"step", " ", "size", " ", "of", " ", "0.001"}]}], ")"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dx", "=", "0.001"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gridS", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "maxIntegrationLimit", ",", "dx"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Calculate", " ", "the", " ", "total", " ", "deviations", " ", 
     "using", " ", "a", " ", "fast", " ", "discrete", " ", "sum"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"totalMSD", "=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"msdDiff", "/@", "gridS"}], "]"}], "*", "dx"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"totalCvM", "=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"cvmDiff", "/@", "gridS"}], "]"}], "*", "dx"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Format", " ", "the", " ", "numbers", " ", "to", " ", "scientific", " ", 
     "notation", " ", "for", " ", "clean", " ", "display"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"textMSD", "=", 
     RowBox[{"\"\<Total MSD: \>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"ScientificForm", "[", 
        RowBox[{"totalMSD", ",", "3"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"textCvM", "=", 
