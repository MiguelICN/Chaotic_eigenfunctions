Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"ks", "=", 
       RowBox[{"kStr", "[", "ki", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fileEven", "=", 
       RowBox[{
       "baseDirEven", "<>", "\"\<spectra_k\>\"", "<>", "ks", 
        "<>", "\"\<.mx\>\""}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fileOdd", "=", 
       RowBox[{
       "baseDirOdd", "<>", "\"\<spectra_k\>\"", "<>", "ks", 
        "<>", "\"\<.mx\>\""}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FileExistsQ", "[", "fileEven", "]"}]}], "||", 
         RowBox[{"!", 
          RowBox[{"FileExistsQ", "[", "fileOdd", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<  SKIP k=\>\"", ",", "ks", 
           ",", "\"\<: file not found\>\""}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"allGofEven", ",", 
           RowBox[{"{", 
            RowBox[{"ki", ",", 
             RowBox[{"Missing", "[", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"allGofOdd", ",", 
           RowBox[{"{", 
            RowBox[{"ki", ",", 
             RowBox[{"Missing", "[", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dataeven", "=", 
       RowBox[{"Import", "[", "fileEven", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dataodd", "=", 
       RowBox[{"Import", "[", "fileOdd", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"gofE", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"ComputeGoFSingle", "[", 
          RowBox[{"dataeven", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "dataeven", "]"}]}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gofO", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"ComputeGoFSingle", "[", 
          RowBox[{"dataodd", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "dataodd", "]"}]}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"ratiosE", "=", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"MeanLevelSpacingRatio", "[", 
            RowBox[{"Sort", "[", 
             RowBox[{"dataeven", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "dataeven", "]"}]}], "}"}], ",", 
           RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"ratiosO", "=", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"MeanLevelSpacingRatio", "[", 
            RowBox[{"Sort", "[", 
             RowBox[{"dataodd", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "dataodd", "]"}]}], "}"}], ",", 
           RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
        ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Mean", " ", "over", " ", 
        RowBox[{"ensemble", ":", 
         RowBox[{"{", 
          RowBox[{
          "KS_s", ",", "CvM_s", ",", "MSD_s", ",", "KS_r", ",", "CvM_r", ",", 
           "MSD_r"}], "}"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"allGofEven", ",", 
        RowBox[{"{", 
         RowBox[{"ki", ",", 
          RowBox[{"Mean", "[", "gofE", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"allGofOdd", ",", 
        RowBox[{"{", 
         RowBox[{"ki", ",", 
          RowBox[{"Mean", "[", "gofO", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"allratiosEven", ",", 
          RowBox[{"{", 
           RowBox[{"ki", ",", 
            RowBox[{"Mean", "[", "ratiosE", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"allratiosOdd", ",", 
          RowBox[{"{", 
           RowBox[{"ki", ",", 
            RowBox[{"Mean", "[", "ratiosO", "]"}]}], "}"}]}], "]"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<  k=\>\"", ",", "ks", ",", "\"\< done\>\""}], "]"}], 
      ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"ki", ",", "klist"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Filter", " ", "out", " ", "missing", " ", "entries"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"validEven", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"allGofEven", ",", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"MissingQ", "[", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"validOdd", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"allGofOdd", ",", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MissingQ", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Extract", ":", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "metric_value"}], "}"}], " ", "for", " ", "each", " ",
      "metric"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"kValsE", "=", 
   RowBox[{"validEven", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kValsO", "=", 
   RowBox[{"validOdd", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"metricsE", "=", 
    RowBox[{"validEven", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", 
