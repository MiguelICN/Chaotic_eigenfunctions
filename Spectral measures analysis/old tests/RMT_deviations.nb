Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "the", " ", "theoretical", " ", "Probability", " ",
     "Density", " ", "Function", " ", 
    RowBox[{"(", "PDF", ")"}], " ", "for", " ", "Wigner"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"theoPDFS", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pi", "/", "2"}], ")"}], "*", "x", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "4"}], ")"}]}], "*", 
        RowBox[{"x", "^", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Define", " ", "the", " ", "two", " ", "squared", " ", 
     "difference", " ", "functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Raw", " ", "squared", " ", "difference", " ", 
     RowBox[{"(", 
      RowBox[{"MSD", " ", "integrand"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"msdDiff", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"expCDFS", "[", "x", "]"}], "-", 
        RowBox[{"theoCDFS", "[", "x", "]"}]}], ")"}], "^", "2"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Weighted", " ", "squared", " ", "difference", " ", 
     RowBox[{"(", 
      RowBox[{"CvM", " ", "integrand"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cvmDiff", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"expCDFS", "[", "x", "]"}], "-", 
         RowBox[{"theoCDFS", "[", "x", "]"}]}], ")"}], "^", "2"}], "*", 
      RowBox[{"theoPDFS", "[", "x", "]"}]}]}], ";"}]}]}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"0e88ca92-81ed-9c4f-b538-fe226d5e87fa"],

