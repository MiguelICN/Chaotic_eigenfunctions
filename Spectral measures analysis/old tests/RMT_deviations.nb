           RowBox[{"gofOddTable", "[", "metric", "]"}]}], ";", "\n", "    ", 
          RowBox[{"plt", " ", "=", " ", 
           RowBox[{"Legended", "[", "\n", "      ", 
            RowBox[{
             RowBox[{"Show", "[", "\n", "        ", 
