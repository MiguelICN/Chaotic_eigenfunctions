       RowBox[{"qktEnsemble", "[", "\"\<Odd\>\"", "]"}], "]"}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n--- Even ensemble ---\>\"", "]"}], ";"}], "\n", 
