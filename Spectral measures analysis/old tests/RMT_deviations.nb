                 "Automatic", ",", " ", "\"\<ProbabilityDensity\>\"", ",", 
                 "\n", "          ", 
                 RowBox[{"ChartStyle", " ", "->", " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Directive", "[", 
                    RowBox[{"Blue", ",", " ", 
                    RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}], ",", "\n", 
                    "                         ", 
                    RowBox[{"Directive", "[", 
                    RowBox[{
                    RowBox[{"Darker", "[", "Green", "]"}], ",", " ", 
                    RowBox[{"Opacity", "[", "0.5", "]"}]}], "]"}]}], 
