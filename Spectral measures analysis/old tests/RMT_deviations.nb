    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tEE", ",", " ", "gofEvenEns"}], "}"}], " ", "=", " ", 
     RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
      RowBox[{"ComputeGoFEnsemble", "[", 
       RowBox[{"qktEnsemble", "[", "\"\<Even\>\"", "]"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
