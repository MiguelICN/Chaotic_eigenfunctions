Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qktEnsemble", "[", 
    RowBox[{"[", "\"\<Odd\>\"", "]"}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "2"}], "]"}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9830002472112083`*^9, 3.9830003019378223`*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"e6bc5363-d3b6-4f4e-9885-57591effcd3e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", 
    RowBox[{"Assume", "'"}], 
    RowBox[{"eigenvalues", "'"}], " ", "is", " ", "your", " ", "list", " ", 
    "of", " ", "complex", " ", "eigenvalues", " ", "from", " ", "the", " ", 
    "Floquet", " ", "operator"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Extract", " ", "the", " ", "phases", " ", 
    RowBox[{"(", "quasienergies", ")"}], " ", "and", " ", "sort", " ", 
    "them"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"phases", "=", 
     RowBox[{
      RowBox[{"qktEnsemble", "[", 
       RowBox[{"[", "\"\<Odd\>\"", "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Nlevels", "=", 
     RowBox[{"Length", "[", "phases", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2.", " ", "Compute", " ", "the", " ", "nearest"}], "-", 
     RowBox[{
     "neighbor", " ", "spacings", " ", "with", " ", "periodic", " ", 
      "boundary", " ", "conditions"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Since", " ", "phases", " ", "are", " ", "in", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "Pi"}], ",", "Pi"}]}]}], "]"}], ",", 
     RowBox[{
     "the", " ", "total", " ", "length", " ", "of", " ", "the", " ", 
      "spectrum", " ", "is", " ", "2", "*", "Pi"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rawSpacings", "=", 
     RowBox[{"Differences", "[", "phases", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"rawSpacings", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "Pi"}], "-", 
         RowBox[{"Last", "[", "phases", "]"}]}], ")"}], "+", 
       RowBox[{"First", "[", "phases", "]"}]}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Unfold", " ", "the", " ", "spectrum"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"For", " ", "Floquet", " ", "operators"}], ",", 
     RowBox[{
     "the", " ", "density", " ", "of", " ", "states", " ", "is", " ", 
      "uniform"}], ",", 
     RowBox[{
     "so", " ", "the", " ", "mean", " ", "spacing", " ", "is", " ", "just", " ",
       "2", "*", 
      RowBox[{"Pi", "/", "N"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"meanSpacing", "=", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "/", "Nlevels"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sVals", "=", 
     RowBox[{"rawSpacings", "/", "meanSpacing"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Compute", " ", "the", " ", "adjacent", " ", "gap", " ", 
     "ratios", " ", 
     RowBox[{"(", "r", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"We", " ", "use", " ", "the", " ", "bounded", " ", 
      RowBox[{"definition", ":", "r_i"}]}], "=", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"s_i", ",", 
        RowBox[{"s_", 
         RowBox[{"{", 
          RowBox[{"i", "+", "1"}], "}"}]}]}], "]"}], "/", 
      RowBox[{"Max", "[", 
       RowBox[{"s_i", ",", 
        RowBox[{"s_", 
         RowBox[{"{", 
          RowBox[{"i", "+", "1"}], "}"}]}]}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rVals", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"sVals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"sVals", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"i", ",", "Nlevels"}], "]"}], "+", "1"}], "]"}], 
           "]"}]}], "]"}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"sVals", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", 
          RowBox[{"sVals", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"i", ",", "Nlevels"}], "]"}], "+", "1"}], "]"}], 
           "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "Nlevels"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"cc7d707b-76ac-d34a-8613-e2ce429cb865"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"5.", " ", "Create", " ", "the", " ", "Experimental", " ", 
    RowBox[{"(", "Numerical", ")"}], " ", "Cumulative", " ", 
    "Distributions"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "EmpiricalDistribution", " ", "creates", " ", "a", " ", "step", " ", 
    "function", " ", "from", " ", "the", " ", "data"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"distS", "=", 
     RowBox[{"EmpiricalDistribution", "[", "sVals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"distR", "=", 
     RowBox[{"EmpiricalDistribution", "[", "rVals", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"expCDFS", "[", "x_", "]"}], ":=", 
     RowBox[{"CDF", "[", 
      RowBox[{"distS", ",", "x"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"expCDFR", "[", "x_", "]"}], ":=", 
     RowBox[{"CDF", "[", 
      RowBox[{"distR", ",", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "6.", " ", "Define", " ", "the", " ", "Theoretical", " ", "Distributions",
      " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"COE", "/", "GOE"}], ",", 
       RowBox[{"beta", "=", "1"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Wigner", " ", "surmise", " ", "for", " ", "spacing", " ", "s"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"theoCDFS", "[", "x_", "]"}], ":=", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "4"}], ")"}]}], "*", 
        RowBox[{"x", "^", "2"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Atas", " ", "et", " ", 
     RowBox[{"al", ".", "distribution"}], " ", "for", " ", "the", " ", 
     "bounded", " ", "gap", " ", "ratio", " ", "r"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"theoPDFR", "[", "x_", "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"27", "/", "8"}], ")"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "+", 
         RowBox[{"x", "^", "2"}]}], ")"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "x", "+", 
          RowBox[{"x", "^", "2"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"5", "/", "2"}], ")"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Mathematica", " ", "can", " ", "integrate", " ", "this", " ", 
     "analytically", " ", "for", " ", "the", " ", "CDF"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"theoCDFR", "[", "x_", "]"}], "=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"theoPDFR", "[", "r", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "0", ",", "x"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"af6d28fa-dd36-b143-8d77-6dfbebd284d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "7.", " ", "Plot", " ", "and", " ", "Compare", " ", "the", " ", 
    "Integrated", " ", "Distributions"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"plotS", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"expCDFS", "[", "x", "]"}], ",", 
