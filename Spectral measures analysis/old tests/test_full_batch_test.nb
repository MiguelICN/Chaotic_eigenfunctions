Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"MODULE", " ", "12"}], ":", 
    RowBox[{"INDIVIDUAL", " ", "REALIZATION", " ", "COLLAGES"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== INDIVIDUAL REALIZATION COLLAGES ===\>\"", "]"}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"collageDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"resultsDir", ",", "\"\<individual\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"EnsureDir", "[", "collageDir", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Helper", ":", 
     RowBox[{"single", "-", 
      RowBox[{"realization", " ", "plots", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"no", " ", "legends"}], ",", "compact"}], ")"}]}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$cOpts", "=", 
     RowBox[{"Sequence", "[", 
      RowBox[{
       RowBox[{"ImageSize", "->", "380"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"16", ",", "Black"}], "]"}]}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"16", ",", "Black"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SingleNNSD", "[", 
      RowBox[{"spacings_", ",", "title_"}], "]"}], ":=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"Histogram", "[", 
        RowBox[{"spacings", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "4", ",", "0.05"}], "}"}], 
         ",", "\"\<ProbabilityDensity\>\"", ",", 
         RowBox[{"ChartStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"LightBlue", ",", 
            RowBox[{"EdgeForm", "[", "Gray", "]"}]}], "]"}]}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "3.5"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1.1"}], "}"}]}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"WignerCOE", "[", "s", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "0", ",", "3.5"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", "s"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "0", ",", "3.5"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}], ",", "$cOpts", 
       ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<s\>\"", ",", "\"\<P(s)\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "title"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SingleCumulativeS", "[", 
      RowBox[{"spacings_", ",", "title_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sorted", ",", "nSp", ",", "empCDF", ",", "coeCDF"}], "}"}], ",", 
       RowBox[{
        RowBox[{"sorted", "=", 
         RowBox[{"Sort", "[", "spacings", "]"}]}], ";", 
        RowBox[{"nSp", "=", 
         RowBox[{"Length", "[", "sorted", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"empCDF", "=", 
         RowBox[{
          RowBox[{"Range", "[", "nSp", "]"}], "/", "nSp"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coeCDF", "=", 
         RowBox[{"IntWignerCOE", "/@", "sorted"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"sorted", ",", "empCDF"}], "}"}], "]"}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{"Blue", ",", "Thick"}], "}"}]}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "3.5"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}]}], "]"}], ",", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"IntWignerCOE", "[", "s", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "0", ",", "3.5"}], "}"}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{"Red", ",", "Thick"}], "}"}]}]}], "]"}], ",", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"1", "-", 
             RowBox[{"Exp", "[", 
              RowBox[{"-", "s"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "0", ",", "3.5"}], "}"}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}], ",", 
          "$cOpts", ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<s\>\"", ",", "\"\<I(s)\>\""}], "}"}]}], ",", 
          RowBox[{"PlotLabel", "->", "title"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SingleFluctuation", "[", 
      RowBox[{"specData_", ",", "title_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"fluc", "=", 
         RowBox[{"GetFluctuations", "[", "specData", "]"}]}], "}"}], ",", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"fluc", "[", "\"\<x\>\"", "]"}], ",", 
            RowBox[{"fluc", "[", "\"\<delta\>\"", "]"}]}], "}"}], "]"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Blue", ",", 
            RowBox[{"AbsoluteThickness", "[", "0.5", "]"}]}], "}"}]}], ",", 
         "$cOpts", ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<x\>\"", 
            ",", "\"\<\\!\\(\\*OverscriptBox[\\(N\\), \\(~\\)]\\)(x)\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "title"}], ",", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", 
            RowBox[{"{", "0", "}"}]}], "}"}]}], ",", 
         RowBox[{"GridLinesStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", "Dashed"}], "]"}]}]}], "]"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Main", " ", "export", " ", "loop"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nReal", "=", 
     RowBox[{"Length", "[", 
      RowBox[{"qktEnsemble", "[", "\"\<Even\>\"", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"specEven", "=", 
        RowBox[{
         RowBox[{"qktEnsemble", "[", "\"\<Even\>\"", "]"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"specOdd", "=", 
        RowBox[{
         RowBox[{"qktEnsemble", "[", "\"\<Odd\>\"", "]"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"spE", "=", 
        RowBox[{"NNSpacings", "[", "specEven", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"spO", "=", 
        RowBox[{"NNSpacings", "[", "specOdd", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"iLabel", "=", 
        RowBox[{"StringPadLeft", "[", 
         RowBox[{
          RowBox[{"ToString", "[", "i", "]"}], ",", "4", ",", "\"\<0\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"collage", "=", 
        RowBox[{"Grid", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Even\>\"", ",", "Bold", ",", "18"}], "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Odd\>\"", ",", "Bold", ",", "18"}], "]"}]}], 
             "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"SingleNNSD", "[", 
               RowBox[{"spE", ",", "\"\<Even P(s)\>\""}], "]"}], ",", 
              RowBox[{"SingleNNSD", "[", 
               RowBox[{"spO", ",", "\"\<Odd P(s)\>\""}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"SingleCumulativeS", "[", 
               RowBox[{"spE", ",", "\"\<Even I(s)\>\""}], "]"}], ",", 
              RowBox[{"SingleCumulativeS", "[", 
               RowBox[{"spO", ",", "\"\<Odd I(s)\>\""}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"SingleFluctuation", "[", 
               RowBox[{"specEven", ",", "\"\<Even fluctuation\>\""}], "]"}], ",", 
              RowBox[{"SingleFluctuation", "[", 
               RowBox[{"specOdd", ",", "\"\<Odd fluctuation\>\""}], "]"}]}], 
             "}"}]}], "}"}], ",", 
          RowBox[{"Spacings", "->", 
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}]}], ",", 
          RowBox[{"Frame", "->", "All"}], ",", 
          RowBox[{"FrameStyle", "->", 
           RowBox[{"GrayLevel", "[", "0.8", "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"collageDir", ",", 
            
            RowBox[{"\"\<realization_\>\"", "<>", "iLabel", 
             "<>", "\"\<.png\>\""}]}], "}"}], "]"}], ",", "collage", ",", 
         RowBox[{"ImageResolution", "->", "150"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"i", ",", "50"}], "]"}], "==", "0"}], "||", 
          RowBox[{"i", "==", "1"}]}], ",", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<  Exported realization \>\"", ",", "i", 
           ",", "\"\</\>\"", ",", "nReal"}], "]"}]}], "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "nReal"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Individual collages complete: \>\"", ",", "collageDir"}], 
     "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9827567225744095`*^9, 3.9827567225900745`*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"c057158f-ed63-5b45-8019-3d7928d650e7"],

