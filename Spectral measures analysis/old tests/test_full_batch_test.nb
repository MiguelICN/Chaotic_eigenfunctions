Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"MODULE", " ", "4"}], ":", " ", 
    RowBox[{"QKT", " ", "ENSEMBLE"}]}], 
   "                                          ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== QKT ENSEMBLE ===\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kList", " ", "=", " ", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"kCenter", " ", "-", " ", "delta"}], ",", " ", 
         RowBox[{"kCenter", " ", "+", " ", "delta"}]}], "}"}], ",", " ", 
       "nQKT"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Diagonalizing \>\"", ",", " ", "nQKT", ",", 
      " ", "\"\< QKT matrices (J=\>\"", ",", " ", "J", ",", 
      " ", "\"\<)...\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tDiag", ",", " ", "qktEnsemble"}], "}"}], " ", "=", " ", 
     RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
      RowBox[{"GenerateQKTEnsemble", "[", 
       RowBox[{"J", ",", " ", "alpha", ",", " ", "kList"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Done in \>\"", ",", " ", 
      RowBox[{"Round", "[", 
       RowBox[{"tDiag", ",", " ", "0.1"}], "]"}], ",", " ", "\"\<s\>\""}], 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"dimE", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"qktEnsemble", "[", "\"\<Even\>\"", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<N\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dimO", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"qktEnsemble", "[", "\"\<Odd\>\"", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<N\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Even N = \>\"", ",", " ", "dimE", ",", 
      " ", "\"\<, Odd N = \>\"", ",", " ", "dimO"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "Export"}]}], " ", 
      RowBox[{"spectra", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
