Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "2.", " ", "Define", " ", "a", " ", "function", " ", "to", " ", 
     "transform", " ", "Quasienergies", " ", "into", " ", "sorted", " ", 
     "Phases", " ", 
     RowBox[{"on", "[", 
      RowBox[{"0", ",", 
       RowBox[{"2", "Pi"}]}]}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"processSpectrum", "[", "assoc_", "]"}], ":=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<N\>\"", "->", 
       RowBox[{"assoc", "[", "\"\<N\>\"", "]"}]}], ",", 
      RowBox[{"\"\<Phases\>\"", "->", 
       RowBox[{"Sort", "[", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Arg", "[", 
           RowBox[{"assoc", "[", "\"\<Quasienergies\>\"", "]"}], "]"}], ",", 
          RowBox[{"2", " ", "Pi"}]}], "]"}], "]"}]}]}], "|>"}]}], 
   ";"}]}]], "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"c9a38546-2e77-dc42-b871-dc756c113263"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"1.", " ", "Import", " ", "your", " ", "data"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dataeven", "=", 
     RowBox[{
     "Import", 
      "[", "\"\<E:\\\\MINIPC\\\\more spectrum \
Results\\\\Even\\\\spectra_k27.50.wdx\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dataodd", "=", 
     RowBox[{
     "Import", 
      "[", "\"\<E:\\\\MINIPC\\\\more spectrum \
Results\\\\Odd\\\\spectra_k27.50.wdx\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Map", " ", "the", " ", "function", " ", "over", " ", "your", " ",
      "ensembles"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"formattedEven", "=", 
     RowBox[{"processSpectrum", "/@", "dataeven"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"formattedOdd", "=", 
     RowBox[{"processSpectrum", "/@", "dataodd"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Rebuild", " ", "the", " ", "master", " ", "ensemble"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"qktEnsemble", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Even\>\"", "->", "formattedEven"}], ",", 
       RowBox[{"\"\<Odd\>\"", "->", "formattedOdd"}]}], "|>"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Optional", ":", 
     RowBox[{
     "Clear", " ", "the", " ", "raw", " ", "data", " ", "to", " ", "save", " ",
       "RAM"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", 
