         RowBox[{"sigma2COE", "[", "\"\<Sigma2TheorMean\>\"", "]"}], " ", "+",
          " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ")"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  COE max dual diff = \>\"", ",", " ", 
      RowBox[{"NumberForm", "[", 
       RowBox[{"relDiffCOE", ",", " ", "4"}], "]"}]}], "]"}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "COE"}]}], " ", 
      RowBox[{"SFF", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Computing COE SFF...\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tSFF", ",", " ", "sffCOE"}], "}"}], " ", "=", " ", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"EnsembleSFF", "[", 
       RowBox[{"coeSpectra", ",", " ", "tauMax", ",", " ", "nPtsSFF"}], "]"}],
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Done in \>\"", ",", " ", 
      RowBox[{"Round", "[", 
       RowBox[{"tSFF", ",", " ", "0.1"}], "]"}], ",", " ", "\"\<s\>\""}], 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Free", " ", "COE", " ", "spectra"}], ",", " ", 
     RowBox[{"keep", " ", "summary", " ", "data"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"coeSpectra", " ", "=", " ", "."}], ";"}], "\n", 
