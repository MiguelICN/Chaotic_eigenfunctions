       "vecsEven", ",", " ", "vecsOdd", ",", " ", "idxE", ",", " ", "idxO", ",",
       "fullVecsEven", ",", " ", "fullVecsOdd", ",", "D"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "2.", " ", "Symmetric", " ", "Floquet", " ", "operator", " ", "in", " ", 
      "Jz", " ", "basis"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"D", "=", 
