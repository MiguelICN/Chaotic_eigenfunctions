      RowBox[{"d", "=", 
       RowBox[{
        RowBox[{"2", " ", "jParam"}], " ", "+", " ", "1"}]}], ",", "mat", ",",
       " ", "idx", ",", " ", "matEven", ",", " ", "matOdd", ",", " ", 
