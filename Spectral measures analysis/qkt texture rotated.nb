Cell[CellGroupData[{

Cell["SFF", "Title",
 CellChangeTimes->{{3.985460537717642*^9, 
  3.985460538997761*^9}},ExpressionUUID->"74602b1e-1bd3-7846-9239-\
10f83fc84e35"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EnsembleSFFFull", "[", 
    RowBox[{"spectraList_List", ",", "tauMax_Real", ",", "nPts_Integer"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nMat", ",", "taus", ",", "specArray", ",", "allK"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nMat", "=", 
       RowBox[{"Length", "[", "spectraList", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"taus", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", "nPts"}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{"tauMax", "/", "nPts"}], ")"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"specArray", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", "\"\<Spectrum\>\"", "]"}], "&"}], ",", 
         "spectraList"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"DistributeDefinitions", "[", 
       RowBox[{"CompileSFF", ",", "taus", ",", "specArray"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"allK", "=", 
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"CompileSFF", "[", 
          RowBox[{
           RowBox[{"specArray", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "taus"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nMat"}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Tau\>\"", "->", "taus"}], ",", 
        RowBox[{"\"\<AllK\>\"", "->", "allK"}], ",", 
        RowBox[{"\"\<MeanK\>\"", "->", 
         RowBox[{"Mean", "[", "allK", "]"}]}], ",", 
        RowBox[{"\"\<SE\>\"", "->", 
         RowBox[{
          RowBox[{"StandardDeviation", "[", "allK", "]"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"nMat", "*", "1."}], "]"}]}]}]}], "|>"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SmoothSFF", "[", 
    RowBox[{"kVec_List", ",", "tauVec_List", ",", 
     RowBox[{"sigmaTau_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"GaussianFilter", "[", 
    RowBox[{"kVec", ",", 
     RowBox[{"sigmaTau", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"tauVec", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"tauVec", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9854611600663357`*^9, 3.9854611626687546`*^9}, {
   3.9866333010704765`*^9, 3.986633303342455*^9}, 3.986634207539757*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"f71a9c39-a2eb-0345-a217-909b60db7104"],

