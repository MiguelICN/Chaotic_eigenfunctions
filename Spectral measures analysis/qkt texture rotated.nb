        RowBox[{"jParam", ",", " ", "alphaParam", ",", " ", "kParam"}], "]"}],
        ".", 
       RowBox[{"ConjugateTranspose", "[", "D", "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"idx", " ", "=", " ", 
