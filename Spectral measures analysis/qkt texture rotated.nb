  3.985461191317585*^9}},ExpressionUUID->"1efd4a59-326b-a343-a4da-\
88918e178940"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tauMaxSFF", "=", "3.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nPtsSFF", "=", "10000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sigmaSm", "=", "0.01"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"sffEven", "=", 
   RowBox[{"EnsembleSFFFull", "[", 
    RowBox[{
     RowBox[{"qktEnsemble", "[", "\"\<Even\>\"", "]"}], ",", "tauMaxSFF", ",",
      "nPtsSFF"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sffOdd", "=", 
   RowBox[{"EnsembleSFFFull", "[", 
    RowBox[{
     RowBox[{"qktEnsemble", "[", "\"\<Odd\>\"", "]"}], ",", "tauMaxSFF", ",", 
     "nPtsSFF"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sffCOE", "=", 
    RowBox[{"EnsembleSFFFull", "[", 
     RowBox[{"coeSpectra", ",", "tauMaxSFF", ",", "nPtsSFF"}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tauGrid", "=", 
    RowBox[{"sffEven", "[", "\"\<Tau\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Smooth", " ", "each", " ", "realization", " ", "individually"}], 
    ",", 
    RowBox[{
    "then", " ", "take", " ", "the", " ", "mean", " ", "of", " ", "the", " ", 
     "smoothed", " ", "curves"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kEvenAllSm", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SmoothSFF", "[", 
       RowBox[{"#", ",", "tauGrid", ",", "sigmaSm"}], "]"}], "&"}], ",", 
     RowBox[{"sffEven", "[", "\"\<AllK\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kOddAllSm", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SmoothSFF", "[", 
       RowBox[{"#", ",", "tauGrid", ",", "sigmaSm"}], "]"}], "&"}], ",", 
     RowBox[{"sffOdd", "[", "\"\<AllK\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kCOEAllSm", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"SmoothSFF", "[", 
        RowBox[{"#", ",", "tauGrid", ",", "sigmaSm"}], "]"}], "&"}], ",", 
      RowBox[{"sffCOE", "[", "\"\<AllK\>\"", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"kEvenMeanSm", "=", 
   RowBox[{"Mean", "[", "kEvenAllSm", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kOddMeanSm", "=", 
   RowBox[{"Mean", "[", "kOddAllSm", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kCOEMeanSm", "=", 
    RowBox[{"Mean", "[", "kCOEAllSm", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"kCOEAn", "=", 
   RowBox[{"Map", "[", 
    RowBox[{"COESFFAnalytical", ",", "tauGrid"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.985461192137148*^9, 3.985461192137148*^9}, {
