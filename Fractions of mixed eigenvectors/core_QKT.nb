         ",", "\"\<  |Stable-Krylov|=\>\"", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"vS", "-", "vK"}], "]"}], "]"}]}], "]"}]}]}], "\n", "]"}], 
    ",", "\n", 
    RowBox[{"{", 
     RowBox[{"pt", ",", "testpts"}], "}"}]}], "\n", "]"}], ";"}]}], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"fabbf324-1a2f-9a43-9b5b-42c0d06f8b52"],

