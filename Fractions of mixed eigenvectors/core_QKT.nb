Cell[CellGroupData[{
Cell["QKT", "Title",
 CellChangeTimes->{{3.9935962001376305`*^9, 
  3.993596202125511*^9}},ExpressionUUID->"dbabb6e5-3ceb-e34b-8885-\
f4c8ee1c8c23"],

Cell[CellGroupData[{

Cell["\<\
1.2 su(2) generators (Dicke basis, index 1 <-> m=+j, index 2j+1 <-> m=-j)\
\>", "Section",ExpressionUUID->"03a05b98-0d8d-e841-ab17-999efe7f740e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "JzOp", ",", "JpOp", ",", "JmOp", ",", "JxOp", ",", "JyOp", ",", "JzOpD", ",",
     "RxOp"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JzOp", "[", "j_", "]"}], ":=", 
   RowBox[{
    RowBox[{"JzOp", "[", "j", "]"}], "=", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Band", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
       RowBox[{"Range", "[", 
        RowBox[{"j", ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "j"}], "+", "1"}], ",", 
        RowBox[{
         RowBox[{"2", "j"}], "+", "1"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JpOp", "[", "j_", "]"}], ":=", 
   RowBox[{
    RowBox[{"JpOp", "[", "j", "]"}], "=", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Band", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"j", " ", 
            RowBox[{"(", 
             RowBox[{"j", "+", "1"}], ")"}]}], "-", 
           RowBox[{"m", " ", 
            RowBox[{"(", 
             RowBox[{"m", "+", "1"}], ")"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"j", "-", "1"}], ",", 
           RowBox[{"-", "j"}], ",", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"2", "j"}], "+", "1"}], ",", 
        RowBox[{
         RowBox[{"2", "j"}], "+", "1"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JmOp", "[", "j_", "]"}], ":=", 
   RowBox[{
    RowBox[{"JmOp", "[", "j", "]"}], "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"JpOp", "[", "j", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JxOp", "[", "j_", "]"}], ":=", 
   RowBox[{
    RowBox[{"JxOp", "[", "j", "]"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"JpOp", "[", "j", "]"}], "+", 
       RowBox[{"JmOp", "[", "j", "]"}]}], ")"}], "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JyOp", "[", "j_", "]"}], ":=", 
   RowBox[{
    RowBox[{"JyOp", "[", "j", "]"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"JpOp", "[", "j", "]"}], "-", 
       RowBox[{"JmOp", "[", "j", "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "I"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"JzOpD", "[", "j_", "]"}], ":=", 
   RowBox[{
    RowBox[{"JzOpD", "[", "j", "]"}], "=", 
    RowBox[{"Range", "[", 
     RowBox[{"j", ",", 
      RowBox[{"-", "j"}], ",", 
      RowBox[{"-", "1"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"RxOp", "[", 
    RowBox[{"j_", ",", 
     RowBox[{"prec_", ":", "MachinePrecision"}]}], "]"}], ":=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"I", " ", "Pi", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{"JxOp", "[", "j", "]"}], "]"}]}], ",", "prec"}], "]"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.993598148983305*^9, 3.993598194732527*^9}, {
  3.9935982334374886`*^9, 3.9935982650491714`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"bb300f8f-7289-0c4c-882f-577cb67cd576"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
1.6 Floquet operator F = exp(-i (gamma/2j) Jz^2) exp(-i alpha Jx)\
\>", "Section",ExpressionUUID->"02770b80-aa01-cf45-819f-dc61ff96e577"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FloquetOp", "[", 
    RowBox[{"j_", ",", "alpha_", ",", "gam_", ",", 
     RowBox[{"prec_", ":", "MachinePrecision"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "jzD", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"jzD", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"j", ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"gam", "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "j"}], ")"}]}], ")"}], " ", 
          RowBox[{"jzD", "^", "2"}]}], "]"}], "]"}], ".", 
       RowBox[{"MatrixExp", "[", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "I"}], " ", "alpha", " ", 
           RowBox[{"Normal", "[", 
            RowBox[{"JxOp", "[", "j", "]"}], "]"}]}], ",", "prec"}], "]"}], 
        "]"}]}]}]}], "\n", "]"}]}], ";"}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"abd546ec-cbb4-ea43-a455-9238fdb6ea70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
1.8 Spin-coherent state |theta,phi>: three independent constructions\
\>", "Section",ExpressionUUID->"031181f2-24fa-da4b-a7b1-f434076fd0fa"],

Cell["\<\
Eq. (13a)/(13b) in PRE 110,064222 and Eq. (12) in PRE 108,054217 are the same \
state: expanding J\[PlusMinus]=Jx\[PlusMinus]iJy in mu J- - mu^* J+ gives i \
theta (Jx sin(phi) - Jy cos(phi)) exactly, matching the second paper's \
generator.\
\>", "Text",ExpressionUUID->"dfe8502a-a859-c648-bbe3-5a54c0c78ec6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SCSExact", "[", 
    RowBox[{"j_", ",", "th_", ",", "ph_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xi", ",", "mvals", ",", "terms"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"th", "==", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"UnitVector", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "j"}], "+", "1"}], ",", "1"}], "]"}], "]"}]}], "]"}],
       ";", "\n", 
      RowBox[{"xi", "=", 
       RowBox[{
        RowBox[{"Tan", "[", 
         RowBox[{"th", "/", "2"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "ph"}], "]"}]}]}], ";", "\n", 
      RowBox[{"mvals", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"j", ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ";", "\n", 
      RowBox[{"terms", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"Binomial", "[", 
            RowBox[{
             RowBox[{"2", "j"}], ",", 
             RowBox[{"j", "+", "m"}]}], "]"}], "]"}], " ", 
          RowBox[{"xi", "^", 
           RowBox[{"(", 
            RowBox[{"j", "-", "m"}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "mvals"}], "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{"terms", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           RowBox[{"Abs", "[", "xi", "]"}], "^", "2"}]}], ")"}], "^", 
        "j"}]}]}]}], "\n", "]"}]}], ";"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"0e7467c8-5f74-5d40-b523-b7f89350a193"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SCSStable", "[", 
    RowBox[{
     RowBox[{"j_", "?", "NumericQ"}], ",", 
     RowBox[{"th_", "?", "NumericQ"}], ",", 
     RowBox[{"ph_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\n", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "xi", ",", "mvals", ",", "logs", ",", "maxLog", ",", "terms", ",", 
       "nrm"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"th", "==", "0."}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"UnitVector", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "j"}], "+", "1"}], ",", "1"}], "]"}], "]"}]}], "]"}],
       ";", "\n", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"th", "==", "Pi"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"UnitVector", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"2", "j"}], "+", "1"}], ",", 
           RowBox[{
            RowBox[{"2", "j"}], "+", "1"}]}], "]"}], "]"}]}], "]"}], ";", 
      "\n", 
      RowBox[{"xi", "=", 
       RowBox[{
        RowBox[{"Tan", "[", 
         RowBox[{"th", "/", "2"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "ph"}], "]"}]}]}], ";", "\n", 
      RowBox[{"mvals", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"j", ",", 
         RowBox[{"-", "j"}], ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ";", "\n", 
      RowBox[{"logs", "=", 
       RowBox[{
        RowBox[{"0.5", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"LogGamma", "[", 
            RowBox[{
             RowBox[{"2", "j"}], "+", "1"}], "]"}], "-", 
           RowBox[{"LogGamma", "[", 
            RowBox[{"j", "+", "1", "+", "mvals"}], "]"}], "-", 
           RowBox[{"LogGamma", "[", 
            RowBox[{"j", "+", "1", "-", "mvals"}], "]"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"j", "-", "mvals"}], ")"}], " ", 
         RowBox[{"Log", "[", "xi", "]"}]}]}]}], ";", "\n", 
      RowBox[{"maxLog", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Re", "[", "logs", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"terms", "=", 
       RowBox[{"Exp", "[", 
        RowBox[{"logs", "-", "maxLog"}], "]"}]}], ";", "\n", 
      RowBox[{"nrm", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "terms", "]"}], "^", "2"}], "]"}], "]"}]}], ";",
       "\n", 
      RowBox[{"terms", "/", "nrm"}]}]}], "\n", "]"}]}], ";"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"f05b766a-d252-fb45-b0e0-178061680bb8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SCSKrylov", "[", 
    RowBox[{
     RowBox[{"j_", "?", "NumericQ"}], ",", 
     RowBox[{"th_", "?", "NumericQ"}], ",", 
     RowBox[{"ph_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mu", ",", "dd", ",", "Jp", ",", "Jm", ",", "gen"}], "}"}], ",",
      "\n", 
     RowBox[{
      RowBox[{"dd", "=", 
       RowBox[{
        RowBox[{"2", "j"}], "+", "1"}]}], ";", "\n", 
      RowBox[{"mu", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"th", "/", "2"}], ")"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "ph"}], "]"}]}]}], ";", "\n", 
      RowBox[{"Jp", "=", 
       RowBox[{"N", "[", 
        RowBox[{"JpOp", "[", "j", "]"}], "]"}]}], ";", "\n", 
      RowBox[{"Jm", "=", 
       RowBox[{"Transpose", "[", "Jp", "]"}]}], ";", "\n", 
      RowBox[{"gen", "=", 
       RowBox[{
        RowBox[{"mu", " ", "Jm"}], "-", 
        RowBox[{
         RowBox[{"Conjugate", "[", "mu", "]"}], " ", "Jp"}]}]}], ";", "\n", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{"gen", ",", 
        RowBox[{"UnitVector", "[", 
         RowBox[{"dd", ",", "1"}], "]"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"bac70aed-9f52-da48-93e0-302838ce29ff"],

Cell["\<\
SCSExact = direct closed form, Eq. (13b)/(12), exact Binomial. SCSStable = \
same formula evaluated in log-space (avoids forming (2j)! directly). \
SCSKrylov = Eq. (13a) evaluated literally as the action of a sparse matrix \
exponential on |j,j>, i.e. the route described in PRE 110,064222 Sec. III A.\
\>", "Text",ExpressionUUID->"e1b903f4-f80f-df47-8058-e92cfcccd532"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
1.9 Verification: cross-validation, <J>, normalization, limits, resolution of \
identity\
\>", "Section",ExpressionUUID->"a11c9f6d-45e9-4049-ab25-96de7c2b1428"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"j1", "=", "40"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testpts", "=", 
