Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GetQKTParityEigensystem", "[", 
    RowBox[{"jParam_", ",", " ", "alphaParam_", ",", " ", "kParam_"}], "]"}], 
   " ", ":=", "\n", "  ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mat", ",", " ", "d", ",", " ", "idx", ",", " ", "matEven", ",", " ", 
       "matOdd", ",", " ", "esEven", ",", " ", "esOdd", ",", "\n", 
       "          ", "phEven", ",", " ", "phOdd", ",", " ", "vecsEven", ",", 
       " ", "vecsOdd", ",", " ", "idxE", ",", " ", "idxO", ",", "\n", 
       "          ", "fullVecsEven", ",", " ", "fullVecsOdd"}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{
      RowBox[{"mat", " ", "=", " ", 
       RowBox[{"Floqsym", "[", 
        RowBox[{"jParam", ",", " ", "alphaParam", ",", " ", "kParam"}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{
        RowBox[{"2", " ", "jParam"}], " ", "+", " ", "1"}]}], ";", "\n", 
      "    ", 
      RowBox[{"idx", " ", "=", " ", 
       RowBox[{"ParitySectorIndices", "[", "jParam", "]"}]}], ";", "\n", 
      "    ", 
      RowBox[{"matEven", " ", "=", " ", 
       RowBox[{"mat", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"idx", "[", "\"\<Even\>\"", "]"}], ",", " ", 
          RowBox[{"idx", "[", "\"\<Even\>\"", "]"}]}], "]"}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"matOdd", "  ", "=", " ", 
       RowBox[{"mat", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"idx", "[", "\"\<Odd\>\"", "]"}], ",", " ", 
          RowBox[{"idx", "[", "\"\<Odd\>\"", "]"}]}], "]"}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"esEven", " ", "=", " ", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"matEven", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]}], "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"esOdd", "  ", "=", " ", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"matOdd", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Direct\>\""}]}], "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"phEven", " ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"Arg", "[", 
          RowBox[{"esEven", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"phOdd", "  ", "=", " ", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"Arg", "[", 
          RowBox[{"esOdd", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"idxE", " ", "=", " ", 
       RowBox[{"Ordering", "[", "phEven", "]"}]}], ";", " ", 
      RowBox[{"idxO", " ", "=", " ", 
       RowBox[{"Ordering", "[", "phOdd", "]"}]}], ";", "\n", "    ", 
      RowBox[{"vecsEven", " ", "=", " ", 
       RowBox[{"esEven", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "idxE"}], "]"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"vecsOdd", "  ", "=", " ", 
       RowBox[{"esOdd", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "idxO"}], "]"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"fullVecsEven", " ", "=", " ", 
       RowBox[{"Table", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"vec", " ", "=", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"0.", " ", "+", " ", 
                RowBox[{"0.", " ", "I"}]}], ",", " ", "d"}], "]"}]}], "}"}], ",",
            "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"vec", "[", 
              RowBox[{"[", 
               RowBox[{"idx", "[", "\"\<Even\>\"", "]"}], "]"}], "]"}], " ", "=",
              " ", 
             RowBox[{"vecsEven", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ";", " ", "vec"}]}], "]"}], ",",
          "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"idx", "[", "\"\<Even\>\"", "]"}], "]"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"fullVecsOdd", " ", "=", " ", 
       RowBox[{"Table", "[", "\n", "      ", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"vec", " ", "=", " ", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"0.", " ", "+", " ", 
                RowBox[{"0.", " ", "I"}]}], ",", " ", "d"}], "]"}]}], "}"}], ",",
            "\n", "        ", 
           RowBox[{
            RowBox[{
             RowBox[{"vec", "[", 
              RowBox[{"[", 
               RowBox[{"idx", "[", "\"\<Odd\>\"", "]"}], "]"}], "]"}], " ", "=",
              " ", 
             RowBox[{"vecsOdd", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ";", " ", "vec"}]}], "]"}], ",",
          "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"idx", "[", "\"\<Odd\>\"", "]"}], "]"}]}], "}"}]}], 
        "]"}]}], ";", "\n", "    ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Even\>\"", " ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Quasienergies\>\"", " ", "->", " ", 
            RowBox[{"esEven", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", "\n", 
           "                  ", 
           RowBox[{"\"\<Phases\>\"", " ", "->", " ", "phEven"}], ",", "\n", 
           "                  ", 
           RowBox[{"\"\<Vectors\>\"", " ", "->", " ", "vecsEven"}], ",", "\n",
            "                  ", 
           RowBox[{"\"\<FullVectors\>\"", " ", "->", " ", "fullVecsEven"}]}], 
          "|>"}]}], ",", "\n", "      ", 
        RowBox[{"\"\<Odd\>\"", "  ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Quasienergies\>\"", " ", "->", " ", 
            RowBox[{"esOdd", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", "\n", 
           "                  ", 
           RowBox[{"\"\<Phases\>\"", " ", "->", " ", "phOdd"}], ",", "\n", 
           "                  ", 
           RowBox[{"\"\<Vectors\>\"", " ", "->", " ", "vecsOdd"}], ",", "\n", 
           "                  ", 
           RowBox[{"\"\<FullVectors\>\"", " ", "->", " ", "fullVecsOdd"}]}], 
          "|>"}]}]}], "|>"}]}]}], "\n", "  ", "]"}]}], ";"}]], "Input",
