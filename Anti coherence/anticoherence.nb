Cell[BoxData[{
 RowBox[{
  RowBox[{"newdata", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Log", "[", "i", "]"}]}], "/", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"2", " ", "J"}], "+", "1"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "iprCompiled"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"plot", "=", 
  RowBox[{"ListDensityPlot", "[", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"region", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"region", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "newdata"}], "}"}], 
     "]"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
    RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
    RowBox[{"PlotLabel", "->", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"\"\<D\:2082, J = \>\"", "<>", 
        RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, \[Alpha] = \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"N", "[", "\[Alpha]", "]"}], "]"}], "<>", "\"\<, k = \>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
