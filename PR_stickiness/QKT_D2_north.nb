Cell["Floquet Eigensystem \[LongDash] Parity Decomposition", "Chapter",ExpressionUUID->"32a0d274-2571-a94a-bcfb-b9301e693948"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Similarity", " ", 
      RowBox[{"transform", ":", " ", "mat"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"exp", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "i"}], " ", "alpha", " ", "Sz"}], ")"}], " ", ".", " ",
         "Floq", " ", ".", " ", "exp"}], 
       RowBox[{"(", 
        RowBox[{"i", " ", "alpha", " ", "Sz"}], ")"}]}], "\n", "   ", "=", 
      " ", 
      RowBox[{
       RowBox[{"exp", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "i"}], " ", "alpha", " ", "Sz"}], ")"}], " ", ".", 
         " ", "exp"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "ik"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "J"}], ")"}]}], " ", 
          RowBox[{"Sx", "^", "2"}]}], ")"}], "\n", "   ", 
        RowBox[{"Sx", "^", "2"}], " ", "couples", " ", "m", " ", "to", " ", 
        "m"}], "+", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "only"}]}]}]}], ",", " ", 
    RowBox[{"so", " ", 
     RowBox[{"odd", "/", "even"}], " ", "indices", " ", "decouple", " ", "in",
      " ", 
     RowBox[{"mat", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Print", "[", "\"\<Building Floquet matrix...\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"GetQKTParityEigensystem", "[", 
      RowBox[{"J", ",", "\[Alpha]", ",", "k"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"datasym", "=", 
     RowBox[{"GetQKTParityEigensystemsym", "[", 
      RowBox[{"J", ",", "\[Alpha]", ",", "k"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.990644704187273*^9, 3.9906447094872856`*^9}, {
  3.9906449841343365`*^9, 3.990644992304163*^9}, {3.9906457505419827`*^9, 
