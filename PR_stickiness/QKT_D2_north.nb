Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Similarity", " ", 
      RowBox[{"transform", ":", " ", "mat"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"exp", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "i"}], " ", "alpha", " ", "Sz"}], ")"}], " ", ".", " ",
         "Floq", " ", ".", " ", "exp"}], 
       RowBox[{"(", 
        RowBox[{"i", " ", "alpha", " ", "Sz"}], ")"}]}], "\n", "   ", "=", 
