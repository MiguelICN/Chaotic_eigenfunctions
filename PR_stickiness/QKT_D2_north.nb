      RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"D2", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "log"}], 
      RowBox[{
       RowBox[{"(", "IPR", ")"}], " ", "/", " ", "log"}], 
      RowBox[{"(", "d", ")"}]}]}], ",", "  ", 
