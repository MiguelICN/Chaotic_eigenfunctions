Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Projecting coherent states into Floquet basis...\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"overlaps", "  ", "=", " ", 
   RowBox[{
    RowBox[{"Conjugate", "[", "neweigenvec", "]"}], " ", ".", " ", 
    RowBox[{"Transpose", "[", "statesCompiled", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"overlapsym", "  ", "=", " ", 
    RowBox[{
     RowBox[{"Conjugate", "[", "neweigenvecsym", "]"}], " ", ".", " ", 
     RowBox[{"Transpose", "[", "statesCompiled", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Computing IPR...\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"iprValues", " ", "=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "overlaps", "]"}], "^", "4"}], ",", " ", 
     RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"iprValuesym", " ", "=", " ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "overlapsym", "]"}], "^", "4"}], ",", " ", 
      RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"D2", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "log"}], 
      RowBox[{
       RowBox[{"(", "IPR", ")"}], " ", "/", " ", "log"}], 
      RowBox[{"(", "d", ")"}]}]}], ",", "  ", 
    RowBox[{"d", " ", "=", " ", 
     RowBox[{
      RowBox[{"2", "J"}], "+", "1"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"d2Values", "  ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Log", "[", "iprValues", "]"}]}], " ", "/", " ", 
    RowBox[{"Log", "[", "d", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d2Valuesym", "  ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Log", "[", "iprValuesym", "]"}]}], " ", "/", " ", 
    RowBox[{"Log", "[", "d", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9906440875913563`*^9, 3.9906440888488274`*^9}, {
