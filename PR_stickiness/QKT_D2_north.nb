Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Projecting coherent states into Floquet basis...\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"overlaps", "  ", "=", " ", 
