         " ", "exp"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "ik"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "J"}], ")"}]}], " ", 
          RowBox[{"Sx", "^", "2"}]}], ")"}], "\n", "   ", 
        RowBox[{"Sx", "^", "2"}], " ", "couples", " ", "m", " ", "to", " ", 
        "m"}], "+", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "only"}]}]}]}], ",", " ", 
    RowBox[{"so", " ", 
     RowBox[{"odd", "/", "even"}], " ", "indices", " ", "decouple", " ", "in",
      " ", 
     RowBox[{"mat", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
