     RowBox[{
      RowBox[{"2", "J"}], "+", "1"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"d2Values", "  ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"Log", "[", "iprValues", "]"}]}], " ", "/", " ", 
