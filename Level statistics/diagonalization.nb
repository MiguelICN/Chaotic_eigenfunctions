Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Jmin", "=", "1"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"Start", " ", "J"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Jmax", "=", "100"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"End", " ", "J"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"step", "=", "1"}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", "size"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"\[Alpha]", "=", "0.84"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", "=", "15.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "Directories"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"baseDir", "=", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      "<>", "\"\<Data_eigenvalues\>\""}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dirEven", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"baseDir", ",", "\"\<Even\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dirOdd", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"baseDir", ",", "\"\<Odd\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "directories", " ", "if", " ", "they", " ", 
     RowBox[{"don", "'"}], "t", " ", "exist"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", "baseDir", "]"}]}], ",", 
      RowBox[{"CreateDirectory", "[", "baseDir", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", "dirEven", "]"}]}], ",", 
      RowBox[{"CreateDirectory", "[", "dirEven", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
