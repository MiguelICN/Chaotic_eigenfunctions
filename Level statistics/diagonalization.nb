Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"FASTEST", " ", "METHOD", " ", "for", " ", "Period", " ", "1"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "AnalyzeSpectrumFast", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"AnalyzeSpectrumFast", "[", 
      RowBox[{"maxJ_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"jValues", "=", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", "maxJ", ",", "1"}], "]"}]}], ",", "traceData", ",",
          "len", ",", "window", ",", "fft", ",", "freqs", ",", "amps"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Parallelize", " ", "the", " ", "J", " ", "loop"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"traceData", "=", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Tr", "[", 
            RowBox[{"Floq", "[", 
             RowBox[{"j", ",", "\[Alpha]", ",", "k"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "jValues"}], "}"}], ",", 
           RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"len", "=", 
         RowBox[{"Length", "[", "traceData", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"window", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"HannWindow", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "-", "1"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"len", "-", "1"}], ")"}]}], "-", 
             RowBox[{"1", "/", "2"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "len"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fft", "=", 
         RowBox[{"Fourier", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"traceData", "-", 
             RowBox[{"Mean", "[", "traceData", "]"}]}], ")"}], "*", 
           "window"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"freqs", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", "1"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"Pi", "/", "len"}]}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Floor", "[", 
              RowBox[{"len", "/", "2"}], "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"amps", "=", 
         RowBox[{"Abs", "[", 
          RowBox[{"fft", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", 
             RowBox[{"Floor", "[", 
              RowBox[{"len", "/", "2"}], "]"}]}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"freqs", ",", "amps"}], "}"}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9802591989903965`*^9, 3.9802592086680393`*^9}, {
  3.98025927549876*^9, 3.980259292946293*^9}, {3.9802603276336*^9, 
