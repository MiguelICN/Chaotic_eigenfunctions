Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"2.", " ", "DEFINITIONS", " ", 
    RowBox[{"(", 
     RowBox[{"Distribute", " ", "to", " ", "Kernels"}], ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Standard", " ", "Quantum", " ", "Kicked", " ", "Top", " ", "Floquet", " ",
     "Operator"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"U", "=", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "i"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"k", "/", "2"}], "J"}], ")"}], " ", 
       RowBox[{"Jz", "^", "2"}]}], "]"}], ".", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "i"}], " ", "alpha", " ", "Jy"}], "]"}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Floq", "[", 
      RowBox[{"jVal_", ",", "alpha_", ",", "kVal_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "d", ",", "mRange", ",", "Jz", ",", "Jy", ",", "Kicked", ",", "Rot"}],
         "}"}], ",", 
       RowBox[{
        RowBox[{"d", "=", 
         RowBox[{
          RowBox[{"2", " ", "jVal"}], "+", "1"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mRange", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"jVal", ",", 
           RowBox[{"-", "jVal"}], ",", 
           RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Diagonal", " ", "Kick", " ", "Operator", " ", 
          RowBox[{"(", 
           RowBox[{
           "Jz", " ", "is", " ", "diagonal", " ", "in", " ", "this", " ", 
            "basis"}], ")"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{"Note", ":", 
          RowBox[{"We", " ", "use", " ", 
           RowBox[{"N", "[", "]"}], " ", "to", " ", "ensure", " ", "machine", 
           " ", "precision", " ", "for", " ", "speed"}]}], "*)"}], 
        RowBox[{"Kicked", "=", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"(", 
             RowBox[{"kVal", "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "jVal"}], ")"}]}], ")"}], "*", 
            RowBox[{"mRange", "^", "2"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Rotation", " ", "Operator", " ", 
          RowBox[{"(", 
           RowBox[{"Jy", " ", "construction"}], ")"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"For", " ", "large", " ", "J"}], ",", 
          RowBox[{"RotationMatrix", " ", "is", " ", "efficient"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{"Alternatively", ",", 
          RowBox[{
          "construct", " ", "Jy", " ", "explicitly", " ", "if", " ", "needed",
            " ", "for", " ", "specific", " ", "basis", " ", "conventions"}]}],
          "*)"}], 
        RowBox[{"Rot", "=", 
         RowBox[{"WignerD", "[", 
          RowBox[{"{", 
           RowBox[{"jVal", ",", "alpha", ",", "0", ",", "0"}], "}"}], "]"}]}],
         ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Efficient", " ", "built"}], "-", 
          RowBox[{
          "in", " ", "rotation", " ", "matrix", " ", "for", " ", "Jy"}]}], 
         "*)"}], 
        RowBox[{"(*", 
         RowBox[{"Total", " ", "Floquet", " ", "Operator"}], "*)"}], 
        RowBox[{"Return", "[", 
         RowBox[{"Kicked", ".", "Rot"}], "]"}], ";"}]}], "]"}]}], ";"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{
  3.98030472857436*^9},ExpressionUUID->"43cc8c0c-115c-144d-b5a5-1334bc44da9a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Helper", " ", "to", " ", "process", " ", "a", " ", "single", " ", "J"}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "ProcessJ", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ProcessJ", "[", 
      RowBox[{
      "jVal_", ",", "alpha_", ",", "kVal_", ",", "dEven_", ",", "dOdd_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "mat", ",", "matEven", ",", "matOdd", ",", "evalsEven", ",", 
         "evalsOdd", ",", "fileEven", ",", "fileOdd"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"1.", " ", "Construct", " ", "Full", " ", "Matrix"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mat", "=", 
         RowBox[{"Floq", "[", 
          RowBox[{"jVal", ",", "alpha", ",", "kVal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"2.", " ", "Split", " ", "by", " ", "Parity", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Standard", " ", 
             RowBox[{"Basis", ":", " ", 
              RowBox[{"|", "j"}]}]}], ",", 
            RowBox[{"m", ">", 
             RowBox[{"parity", " ", "alternates"}]}]}], ")"}]}], "*)"}], 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Even", " ", 
           RowBox[{"Parity", ":", 
            RowBox[{"Indices", " ", "1"}]}]}], ",", "3", ",", 
          RowBox[{"5", "..."}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"matEven", "=", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"1", ";;", " ", ";;", "2"}], ",", 
            RowBox[{"1", ";;", " ", ";;", "2"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"matOdd", "=", 
         RowBox[{"mat", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;", " ", ";;", "2"}], ",", 
            RowBox[{"2", ";;", " ", ";;", "2"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"evalsEven", "=", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"matEven", ",", 
           RowBox[{"Method", "->", "\"\<Direct\>\""}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"evalsOdd", "=", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"matOdd", ",", 
           RowBox[{"Method", "->", "\"\<Direct\>\""}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fileEven", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dEven", ",", 
            RowBox[{"\"\<evals_J_\>\"", "<>", 
             RowBox[{"ToString", "[", "jVal", "]"}], "<>", "\"\<.mx\>\""}]}], 
           "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fileOdd", "=", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dOdd", ",", 
            RowBox[{"\"\<evals_J_\>\"", "<>", 
             RowBox[{"ToString", "[", "jVal", "]"}], "<>", "\"\<.mx\>\""}]}], 
           "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{"fileEven", ",", "evalsEven"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Export", "[", 
         RowBox[{"fileOdd", ",", "evalsOdd"}], "]"}], ";", 
        "\[IndentingNewLine]", "jVal"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{"Floq", ",", "ProcessJ"}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9803049427844067`*^9, 3.980304945632475*^9}, {
  3.980305091840315*^9, 3.9803050932084866`*^9}, {3.980305338869297*^9, 
  3.9803053449936028`*^9}, {3.9803053762562237`*^9, 3.9803053790968857`*^9}, {
  3.980305497375042*^9, 3.9803055082625065`*^9}},
 CellLabel->"In[88]:=",ExpressionUUID->"5ce42574-4047-5b40-baa8-f68970a803a8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Starting calculation for J = \>\"", ",", "Jmin", 
     ",", "\"\< to \>\"", ",", "Jmax"}], "]"}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
