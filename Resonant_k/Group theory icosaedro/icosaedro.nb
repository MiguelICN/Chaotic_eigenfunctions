Cell[CellGroupData[{

Cell["Tests for J", "Title",
 CellChangeTimes->{{3.987691022486313*^9, 3.987691022910265*^9}, {
  3.9876910841648827`*^9, 
  3.987691096263426*^9}},ExpressionUUID->"eb8f5216-449d-8c4a-b7b8-\
31bee057a05b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"1.", " ", "Initialize", " ", "Spin"}], "-", 
    RowBox[{"J", " ", "Operators"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"J", " ", "=", " ", "5"}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"dim", " ", "=", " ", 
     RowBox[{
      RowBox[{"2", " ", "J"}], " ", "+", " ", "1"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"J", ",", " ", 
       RowBox[{"-", "J"}], ",", " ", 
       RowBox[{"-", "1"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "High", " ", "precision", " ", "is", " ", "required", " ", "to", " ", 
     "accurately", " ", "distinguish", " ", "true", " ", "degeneracies", " ", 
     "from", " ", "numerical", " ", "noise"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Jz", " ", "=", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"N", "[", 
       RowBox[{"m", ",", " ", "50"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Jp", "=", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"i", "+", "1"}]}], "}"}], "->", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"J", " ", 
             RowBox[{"(", 
              RowBox[{"J", "+", "1"}], ")"}]}], "-", 
            RowBox[{
             RowBox[{"m", "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], "*", 
             RowBox[{"m", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"dim", "-", "1"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"dim", ",", "dim"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.987691156194195*^9, 3.98769118580307*^9}, {
   3.987691237940592*^9, 3.9876912398920994`*^9}, 3.9876928549184856`*^9},
 CellLabel->
  "In[122]:=",ExpressionUUID->"4b603070-e197-2743-87ed-61792ca21482"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Jm", " ", "=", " ", 
   RowBox[{"Transpose", "[", "Jp", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Jx", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Jp", " ", "+", " ", "Jm"}], ")"}], "/", "2"}], ",", " ", 
     "50"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Jy", " ", "=", " ", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Jp", " ", "-", " ", "Jm"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "I"}], ")"}]}], ",", " ", "50"}], "]"}]}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "2.", " ", "Algebraic", " ", "Generation", " ", "of", " ", "the", " ", 
    "60", " ", "Icosahedral", " ", "Operators"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Generator", " ", 
    RowBox[{"A", ":", " ", 
     RowBox[{
      RowBox[{"C5", " ", 
       RowBox[{"(", "pentagonal", ")"}], " ", "rotation", " ", "around", " ", 
       "the", " ", "z"}], "-", "axis"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"genA", " ", "=", " ", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Pi", "/", "5"}]}], ")"}], " ", "Jz"}], "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Generator", " ", 
    RowBox[{"B", ":", " ", 
     RowBox[{
     "C2", " ", "rotation", " ", "around", " ", "an", " ", "axis", " ", 
      "tipped", " ", "by", " ", "angle", " ", "\[Gamma]"}]}]}], " ", "*)"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "angle", " ", "\[Gamma]", " ", "is", " ", "rigorously", " ", 
    "derived", " ", "from", " ", "the", " ", "Icosahedral", " ", "adjacency", 
    " ", "rules"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gamma", " ", "=", " ", 
    RowBox[{"ArcCos", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "-", " ", 
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "5", "]"}]}]}], ")"}], "/", "2"}], "]"}], 
     "]"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"genB", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "Pi", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "gamma", "]"}], " ", "Jx"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"Cos", "[", "gamma", "]"}], " ", "Jz"}]}], ")"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[127]:=",ExpressionUUID->"3c82ff8e-325e-5c4f-baf4-08d5e52ab355"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<Algebraically generating the point group from \
generators...\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"groupIcosahedron", " ", "=", " ", 
    RowBox[{"FixedPoint", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"list", ",", " ", "\n", "    ", 
        RowBox[{"DeleteDuplicates", "[", "\n", "     ", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"list", ",", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"Outer", "[", 
               RowBox[{"Dot", ",", " ", "list", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"genA", ",", " ", "genB"}], "}"}], ",", " ", "1"}], 
               "]"}], ",", " ", "1"}], "]"}]}], "]"}], ",", " ", "\n", 
          "     ", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], " ", "<", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "8"}]}]}], " ", "&"}]}], "]"}]}], "\n", "   ", 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"IdentityMatrix", "[", "dim", "]"}], "}"}]}], "]"}]}], ";"}], 
  "\n", "   "}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Number of unitary operators generated: \>\"", ",", " ", 
    RowBox[{"Length", "[", "groupIcosahedron", "]"}], ",", 
    " ", "\"\< (Expected: 60)\>\""}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[133]:=",ExpressionUUID->"cc34bb63-5a29-eb40-b9f6-396e3618c939"],

