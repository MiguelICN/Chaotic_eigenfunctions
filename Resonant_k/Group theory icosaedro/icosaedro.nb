Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "The", " ", "Exact", " ", "Floquet", " ", "Parameters"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]", " ", "=", " ", 
     RowBox[{"ArcTan", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rotMat", " ", "=", " ", 
     RowBox[{"RotationMatrix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Alpha]"}], "/", "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "2.", " ", "Define", " ", "the", " ", "12", " ", "unrotated", " ", 
     "Icosahedron", " ", "vertices", " ", "natively", " ", "in", " ", "3", 
     "D"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "We", " ", "orient", " ", "it", " ", "so", " ", "the", " ", "North", " ",
       "Pole", " ", "is", " ", "a", " ", "vertex"}], ",", " ", 
     RowBox[{
      RowBox[{
      "and", " ", "one", " ", "adjacent", " ", "vertex", " ", "lies", " ", 
       "on", " ", "the", " ", "negative", " ", "y"}], "-", 
      RowBox[{
      "axis", " ", "to", " ", "properly", " ", "align", " ", "with", " ", 
       "your", " ", "x"}], "-", 
      RowBox[{"axis", " ", "rotation"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"v0", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v11", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0", ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"vInner", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", "*", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[Pi]"}], "/", "2"}], " ", "+", " ", 
            RowBox[{"2", " ", "\[Pi]", " ", 
             RowBox[{"m", " ", "/", " ", "5"}]}]}], "]"}]}], ",", " ", "\n", 
         "   ", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", "*", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[Pi]"}], "/", "2"}], " ", "+", " ", 
            RowBox[{"2", " ", "\[Pi]", " ", 
             RowBox[{"m", " ", "/", " ", "5"}]}]}], "]"}]}], ",", " ", "\n", 
         "   ", 
         RowBox[{"Cos", "[", "\[Alpha]", "]"}]}], "\n", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"vOuter", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", "*", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", 
             RowBox[{"\[Pi]", "/", "10"}]}], " ", "+", " ", 
            RowBox[{"2", " ", "\[Pi]", " ", 
             RowBox[{"m", " ", "/", " ", "5"}]}]}], "]"}]}], ",", " ", "\n", 
         "   ", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", "*", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", 
             RowBox[{"\[Pi]", "/", "10"}]}], " ", "+", " ", 
            RowBox[{"2", " ", "\[Pi]", " ", 
             RowBox[{"m", " ", "/", " ", "5"}]}]}], "]"}]}], ",", " ", "\n", 
         "   ", 
         RowBox[{"-", 
          RowBox[{"Cos", "[", "\[Alpha]", "]"}]}]}], "\n", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"allVertices3D", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"v0", ",", " ", "v11"}], "}"}], ",", " ", "vInner", ",", " ", 
       "vOuter"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "3.", " ", "Apply", " ", "the", " ", "Symmetrization", " ", "Rotation", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[Alpha]"}], "/", "2"}], " ", "around", " ", "the", " ",
         "X"}], "-", "axis"}], ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rotatedVertices3D", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"rotMat", " ", ".", " ", "#"}], ")"}], " ", "&"}], " ", "/@", 
      " ", "allVertices3D"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "4.", " ", "Exact", " ", "Stereographic", " ", "Projection", " ", "from", 
     " ", "the", " ", "South", " ", "Pole"}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Maps", " ", "3", "D", " ", "coordinates", " ", 
       RowBox[{"(", 
        RowBox[{"x", ",", "y", ",", "z"}], ")"}], " ", "to", " ", "2", "D", " ",
        "coordinates", " ", "Q"}], " ", "=", " ", 
      RowBox[{"x", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", "z"}], ")"}]}]}], ",", " ", 
     RowBox[{"P", " ", "=", " ", 
      RowBox[{"y", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", "z"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"projectedVertices2D", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], ",", " ", "\n", "   ", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"1", " ", "+", " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}]}], "\n", "}"}], " ", 
       "&"}], " ", "/@", " ", "rotatedVertices3D"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "The", " ", "rotated", " ", "South", " ", "Pole", " ", "maps", " ", "to",
       " ", "complex", " ", "infinity"}], ",", " ", 
     RowBox[{
     "so", " ", "we", " ", "filter", " ", "it", " ", "out", " ", "for", " ", 
      "plotting"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"plotVertices", " ", "=", " ", 
     RowBox[{"Select", "[", 
      RowBox[{"projectedVertices2D", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", "#", "]"}], " ", "<", " ", "5"}], " ", "&"}]}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"5.", " ", "Overlay", " ", "onto", " ", "your", " ", "plot"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"overlayPlot", " ", "=", " ", 
     RowBox[{"Show", "[", "\n", "   ", 
      RowBox[{"plot", ",", " ", "\n", "   ", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{"White", ",", " ", 
          RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", "\n", 
          "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", " ", "-", " ", 
                RowBox[{"{", 
                 RowBox[{"0.05", ",", " ", "0"}], "}"}]}], ",", " ", 
               RowBox[{"#", " ", "+", " ", 
                RowBox[{"{", 
                 RowBox[{"0.05", ",", " ", "0"}], "}"}]}]}], "}"}], "]"}], 
            " ", "&"}], " ", "/@", " ", "plotVertices"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", " ", "-", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "0.05"}], "}"}]}], ",", " ", 
               RowBox[{"#", " ", "+", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "0.05"}], "}"}]}]}], "}"}], "]"}], 
            " ", "&"}], " ", "/@", " ", "plotVertices"}]}], "\n", "   ", 
         "}"}], "]"}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "overlayPlot", "]"}], ";"}], "\n", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"\"\<d2_J_\>\"", " ", "<>", " ", 
      RowBox[{"ToString", "[", "J", "]"}], " ", "<>", 
      " ", "\"\<_TRUE_EXACT_overlay.png\>\""}], ",", " ", "overlayPlot"}], 
    "]"}]}]}]], "Input",
