Cell[BoxData[{
 RowBox[{
  RowBox[{"dir", "=", "\"\<HusimiPlots\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", 
    RowBox[{"CreateDirectory", "[", "dir", "]"}]}], "]"}], ";"}]}], "Input",
