Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "3.", " ", "Construct", " ", "the", " ", "QKT", " ", "Floquet", " ", 
    "Operator", " ", "at", " ", "the", " ", "Geometric", " ", "Resonance"}], 
   " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Your", " ", 
      RowBox[{"parameters", ":", " ", "J"}]}], "=", "200"}], ",", " ", 
    RowBox[{"k", "=", 
     RowBox[{
     "80", "\[Pi]", " ", "yields", " ", "a", " ", "torsion", " ", 
      "coefficient", " ", "of", " ", "exactly", " ", 
      RowBox[{"\[Pi]", "/", "5"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"alpha", " ", "=", " ", 
     RowBox[{"ArcTan", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"torsionCoeff", " ", "=", " ", 
     RowBox[{"Pi", " ", "/", " ", "5"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"F", " ", "=", " ", 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "torsionCoeff", " ", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"Jx", ",", " ", "2"}], "]"}]}], "]"}], " ", ".", " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "alpha", " ", "Jz"}], "]"}]}]}], ";"}], "\n",
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "4.", " ", "Diagonalize", " ", "and", " ", "Extract", " ", "Degenerate", " ",
      "Multiplets"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Diagonalizing Floquet Operator...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"evals", " ", "=", " ", 
     RowBox[{"Eigenvalues", "[", "F", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"phases", " ", "=", " ", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"Arg", "[", "evals", "]"}], ",", " ", 
       RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Group", " ", "identical", " ", "quasi"}], "-", 
     RowBox[{"energies", " ", 
      RowBox[{"(", 
       RowBox[{
       "rounding", " ", "to", " ", "8", " ", "decimals", " ", "to", " ", 
        "ignore", " ", "machine", " ", "precision", " ", "noise"}], ")"}]}]}],
     " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"groupedLevels", " ", "=", " ", 
     RowBox[{"Tally", "[", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Sort", "[", "phases", "]"}], ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"multipletSizes", " ", "=", " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"groupedLevels", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
