Cell[BoxData[{
 RowBox[{
  RowBox[{"husimiValues", "=", 
   RowBox[{
    RowBox[{"Abs", "[", "overlaps", "]"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"husimiValuesSorted", "=", "husimiValues"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9769335902840595`*^9, 3.976933608417*^9}, {
  3.9769367842744446`*^9, 3.976936784727831*^9}},
 CellLabel->
  "In[253]:=",ExpressionUUID->"a2257326-a993-8040-813a-be68642a4856"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"should", " ", "be", " ", "2", "J"}], "+", "1"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"plots", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"husimiList", ",", "plot"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"husimiList", "=", 
          RowBox[{"MapThread", "[", 
           RowBox[{"Append", ",", 
            RowBox[{"{", 
             RowBox[{"region", ",", 
              RowBox[{"husimiValuesSorted", "[", 
               RowBox[{"[", "q", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"plot", "=", 
          RowBox[{"ListDensityPlot", "[", 
           RowBox[{"husimiList", ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
            RowBox[{"ColorFunction", "->", "\"\<BlueGreenYellow\>\""}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"\"\<Husimi, J = \>\"", "<>", 
