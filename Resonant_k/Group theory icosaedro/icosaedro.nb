Cell["vertex", "Chapter",
 CellChangeTimes->{{3.98769625609334*^9, 
  3.987696256915037*^9}},ExpressionUUID->"7dc91129-a80c-8e4b-ac61-\
187444a4b491"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "Exact", " ", "Golden", " ", "Ratio", " ", "constants", " ", 
    RowBox[{"(", 
     RowBox[{"The", " ", "true", " ", "geometric", " ", "derivations"}], 
     ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"phi", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"phiInv", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sqrt", "[", "5", "]"}], " ", "-", " ", "1"}], ")"}], "/", 
      "2"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"2.", " ", "Corrected", " ", "11", " ", "theoretical", " ", 
     RowBox[{"(", 
      RowBox[{"Q", ",", " ", "P"}], ")"}], " ", "coordinates"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"centerVertex", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0"}], "}"}], "}"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Inner", " ", 
     RowBox[{"ring", ":", " ", 
      RowBox[{
       RowBox[{
       "Aligned", " ", "with", " ", "the", " ", "positive", " ", "Q"}], "-", 
       RowBox[{"axis", " ", 
        RowBox[{"(", 
         RowBox[{"Phase", " ", "=", " ", "0"}], ")"}]}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"innerVertices", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"phiInv", " ", "*", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"m", " ", "/", " ", "5"}]}], "]"}]}], ",", " ", 
         RowBox[{"phiInv", " ", "*", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"m", " ", "/", " ", "5"}]}], "]"}]}]}], "}"}], ",", " ", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "4"}], "}"}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Outer", " ", 
      RowBox[{"ring", ":", " ", 
       RowBox[{"Staggered", " ", "by", " ", 
        RowBox[{"Pi", "/", "5"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
      "meaning", " ", "it", " ", "aligns", " ", "with", " ", "the", " ", 
       "negative", " ", "Q"}], "-", "axis"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"outerVertices", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "phi"}], " ", "*", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"m", " ", "/", " ", "5"}]}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "phi"}], " ", "*", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"m", " ", "/", " ", "5"}]}], "]"}]}]}], "}"}], ",", " ", 
       "\n", "   ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "4"}], "}"}]}], "\n", "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Combine", " ", "all", " ", "points", " ", "into", " ", "a", " ", 
     "single", " ", "list"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"allVertices", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
      "centerVertex", ",", " ", "innerVertices", ",", " ", "outerVertices"}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "3.", " ", "Overlay", " ", "the", " ", "exact", " ", "coordinates", " ", 
     "onto", " ", "your", " ", "existing", " ", "plot"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"overlayPlot", " ", "=", " ", 
     RowBox[{"Show", "[", "\n", "   ", 
      RowBox[{"plot", ",", " ", "\n", "   ", 
       RowBox[{"Graphics", "[", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{"White", ",", " ", 
          RowBox[{"AbsoluteThickness", "[", "2", "]"}], ",", " ", "\n", 
          "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", " ", "-", " ", 
                RowBox[{"{", 
                 RowBox[{"0.05", ",", " ", "0"}], "}"}]}], ",", " ", 
               RowBox[{"#", " ", "+", " ", 
                RowBox[{"{", 
                 RowBox[{"0.05", ",", " ", "0"}], "}"}]}]}], "}"}], "]"}], 
            " ", "&"}], " ", "/@", " ", "allVertices"}], ",", "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Line", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", " ", "-", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "0.05"}], "}"}]}], ",", " ", 
               RowBox[{"#", " ", "+", " ", 
                RowBox[{"{", 
                 RowBox[{"0", ",", " ", "0.05"}], "}"}]}]}], "}"}], "]"}], 
            " ", "&"}], " ", "/@", " ", "allVertices"}]}], "\n", "   ", "}"}],
         "]"}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "4.", " ", "Display", " ", "and", " ", "Export", " ", "the", " ", 
     "overlaid", " ", "plot"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "overlayPlot", "]"}], ";"}], "\n", "\n", 
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"\"\<d2_J_\>\"", " ", "<>", " ", 
      RowBox[{"ToString", "[", "J", "]"}], " ", "<>", " ", "\"\<alpha_\>\"", 
      " ", "<>", " ", 
      RowBox[{"ToString", "[", "\[Alpha]", "]"}], " ", "<>", 
      " ", "\"\<_k_\>\"", " ", "<>", " ", 
      RowBox[{"ToString", "[", "k", "]"}], " ", "<>", 
      " ", "\"\<_overlay_FIXED.png\>\""}], ",", " ", "overlayPlot"}], 
    "]"}]}]}]], "Input",
