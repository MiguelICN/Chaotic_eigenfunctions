Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "Define", " ", "Pauli", " ", "Matrices", " ", "and", " ", "SU", 
    RowBox[{"(", "2", ")"}], " ", "Rotation", " ", "Operator"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"id", " ", "=", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sx", " ", "=", " ", 
     RowBox[{"PauliMatrix", "[", "1", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sy", " ", "=", " ", 
     RowBox[{"PauliMatrix", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sz", " ", "=", " ", 
     RowBox[{"PauliMatrix", "[", "3", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"U", 
      RowBox[{"(", 
       RowBox[{"\[Theta]", ",", " ", "n"}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"cos", 
       RowBox[{"(", 
        RowBox[{"\[Theta]", "/", "2"}], ")"}], " ", "I"}], " ", "-", " ", 
      RowBox[{"i", " ", "sin", 
       RowBox[{"(", 
        RowBox[{"\[Theta]", "/", "2"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"n", " ", ".", " ", "\[Sigma]"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SU2Rot", "[", 
      RowBox[{
      "\[Theta]_", ",", " ", "nx_", ",", " ", "ny_", ",", " ", "nz_"}], "]"}],
      " ", ":=", " ", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], "*", "id"}], " ", "-", " ", 
      RowBox[{"I", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"nx", "*", "sx"}], " ", "+", " ", 
         RowBox[{"ny", "*", "sy"}], " ", "+", " ", 
         RowBox[{"nz", "*", "sz"}]}], ")"}]}]}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"2.", " ", "Generate", " ", "the", " ", "10"}], "-", 
     RowBox[{
     "element", " ", "Abelian", " ", "subgroup", " ", "for", " ", "a", " ", 
      "5"}], "-", 
     RowBox[{"fold", " ", "vertex", " ", "axis"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"We", " ", "use", " ", "the", " ", "z"}], "-", 
     RowBox[{"axis", " ", 
      RowBox[{"(", 
       RowBox[{"0", ",", "0", ",", "1"}], ")"}], " ", "for", " ", "this", " ", 
      RowBox[{"subgroup", ".", " ", "\n", "   ", "The"}], " ", "algebraic", " ",
       "properties", " ", "are", " ", "identical", " ", "for", " ", "any", " ",
       "chosen", " ", "vertex", " ", 
      RowBox[{"axis", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"angles", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"m", "*", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"Pi", "/", "5"}]}], ")"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", "9"}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"subgroup", " ", "=", " ", 
