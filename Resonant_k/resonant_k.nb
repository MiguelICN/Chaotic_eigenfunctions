Cell[CellGroupData[{

Cell["Hypothesis 4", "Title",
 CellChangeTimes->{{3.986641563499012*^9, 
  3.9866415656660824`*^9}},ExpressionUUID->"d12f0c65-b7f9-cb49-97fb-\
3ea9532e4b0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Free", " ", "parameters", " ", 
    "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"J", " ", "=", " ", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alphaTest", " ", "=", " ", 
     RowBox[{"Pi", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"J", " ", "*", " ", "Pi", " ", "*", " ", 
      RowBox[{"(", 
       RowBox[{"2", "/", "5."}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rotOrders", " ", "=", " ", 
     RowBox[{"Range", "[", "100", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.986641628504631*^9, 3.986641630639534*^9}, {
  3.9866417799723377`*^9, 3.9866418060684032`*^9}, {3.986641855451271*^9, 
  3.986641888033331*^9}},
 CellLabel->
  "In[591]:=",ExpressionUUID->"ef3555ee-50f7-4e44-89a1-e2ed98cd3dd6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Operators", " ", 
    "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Fmat", " ", "=", " ", 
     RowBox[{"Floq", "[", 
      RowBox[{"J", ",", "\[Alpha]", ",", "k"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Jz", "   ", "=", " ", 
     RowBox[{"DiagonalMatrix", "[", 
      RowBox[{"Range", "[", 
       RowBox[{"J", ",", " ", 
        RowBox[{"-", "J"}], ",", " ", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9866418366574516`*^9, 3.9866418370113564`*^9}},
 CellLabel->
  "In[595]:=",ExpressionUUID->"75c9d380-abc8-c148-aa72-a72052d87c2f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Commutator", " ", "norms", " ",
     "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"commutatorResults", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Rn", "       ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"Pi", " ", "/", " ", "n"}]}], ")"}], " ", "Jz"}], "]"}]}],
        ";", "\n", "  ", 
       RowBox[{"commNorm", " ", "=", " ", 
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Fmat", " ", ".", " ", "Rn"}], " ", "-", " ", 
           RowBox[{"Rn", " ", ".", " ", "Fmat"}]}], ",", 
          " ", "\"\<Frobenius\>\""}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "commNorm"}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "rotOrders"}], "}"}]}], "\n", "]"}]}], 
   ";"}]}]], "Input",
 CellLabel->
  "In[597]:=",ExpressionUUID->"6e7a9a92-89bf-da46-98aa-de23469ce69a"],

