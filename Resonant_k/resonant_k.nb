Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Components", " ", "of"}], " ", "|", "\[Theta]"}], ",", 
    RowBox[{
     RowBox[{"\[CurlyPhi]\:27e9", " ", "in", " ", "the"}], " ", "|", "S"}], ",", 
    RowBox[{"m\:27e9", " ", "basis"}], ",", " ", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"-", "S"}]}], ",", "...", ",", 
    RowBox[{"S", "  ", "[", 
     RowBox[{"Eq", ".", " ", "2.5"}], "]"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"CoherentStateSpin", "[", 
     RowBox[{"S_", ",", "\[Theta]_", ",", "\[CurlyPhi]_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"2", "S"}], ",", 
          RowBox[{"S", "+", "m"}]}], "]"}], "]"}], "*", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"S", "+", "m"}], "==", "0"}], ",", "1", ",", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"S", "+", "m"}], ")"}]}]}], "]"}], "*", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"S", "-", "m"}], "==", "0"}], ",", "1", ",", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"S", "-", "m"}], ")"}]}]}], "]"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], 
         RowBox[{"(", 
          RowBox[{"S", "+", "m"}], ")"}], " ", "\[CurlyPhi]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"-", "S"}], ",", "S"}], "}"}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", 
       RowBox[{"(", 
        RowBox[{"\[Theta]", ",", "\[CurlyPhi]"}], ")"}]}], " ", "=", " ", 
      RowBox[{"|", "\:27e8\[Theta]"}]}], ",", 
     RowBox[{"\[CurlyPhi]", "|", "\[Psi]\:27e9", "|", "\.b2"}], "  ", "\[LongDash]",
      " ", 
     RowBox[{
      RowBox[{"state", " ", "is", " ", "a", " ", "length"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "S"}], "+", "1"}], ")"}], " ", "vector"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"HusimiQ", "[", 
     RowBox[{
     "state_", ",", " ", "S_", ",", " ", "\[Theta]_", ",", " ", 
      "\[CurlyPhi]_"}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"CoherentStateSpin", "[", 
         RowBox[{"S", ",", " ", "\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], 
        "]"}], " ", ".", " ", "state"}], "]"}], "^", "2"}]}]}]}]], "Input",
 CellChangeTimes->{3.987260463512787*^9, 3.987260859458124*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"868d3c37-6d41-9543-a24f-8072937584fc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
