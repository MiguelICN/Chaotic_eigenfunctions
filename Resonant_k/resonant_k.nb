            "      ", "\"\<_phi\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"quasienergies", "[", 
                RowBox[{"[", "idx", "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"5", ",", "3"}], "}"}]}], "]"}], "]"}], " ", "<>", 
            "\n", "      ", "\"\<.png\>\""}]}], "}"}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"Export", "[", 
        RowBox[{"fname", ",", " ", "plot"}], "]"}], ";"}]}], "\n", "  ", 
     "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"n", ",", " ", "1", ",", " ", "nPlot"}], "}"}], ",", "\n", "  ", 
    RowBox[{"Method", " ", "->", " ", "\"\<CoarsestGrained\>\""}]}], "\n", 
   "]"}], ";"}]], "Input",
