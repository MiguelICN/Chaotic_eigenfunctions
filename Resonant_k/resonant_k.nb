           RowBox[{"Cos", "[", 
            RowBox[{"2", "\[Pi]", " ", 
             RowBox[{"k", "/", "5"}]}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"2", "\[Pi]", " ", 
             RowBox[{"k", "/", "5"}]}], "]"}]}], ",", "  ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"2", "\[Pi]", " ", 
              RowBox[{"k", "/", "5"}]}], " ", "+", " ", 
             RowBox[{"\[Pi]", "/", "5"}]}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"2", "\[Pi]", " ", 
              RowBox[{"k", "/", "5"}]}], " ", "+", " ", 
             RowBox[{"\[Pi]", "/", "5"}]}], "]"}]}], ",", " ", 
          RowBox[{"-", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
     "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Multipole", " ", "strength", " ", "w_K", " ", "for", " ", "a", " ", 
      "given", " ", 
      RowBox[{"state", " ", "[", 
       RowBox[{"Eq", ".", " ", "4.7"}], "]"}]}], " ", "\[LongDash]", " ", 
     "\n", "   ", 
     RowBox[{
