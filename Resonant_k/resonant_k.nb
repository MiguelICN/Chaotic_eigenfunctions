Cell[CellGroupData[{

Cell["Husimis of degenerate groups", "Chapter",
 CellChangeTimes->{{3.9866351710587177`*^9, 3.9866351718801956`*^9}, {
  3.9872532379698906`*^9, 
  3.9872532421823597`*^9}},ExpressionUUID->"17570508-06cc-2948-9a27-\
0679fde52719"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Operates", " ", "on", " ", "a", " ", "single", " ", 
     RowBox[{"sector", "'"}], "s", " ", "phase", " ", "list"}], ";", " ", 
    RowBox[{
    "returns", " ", "indices", " ", "local", " ", "to", " ", "that", " ", 
     "sector"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GroupStateIndicesSector", "[", 
      RowBox[{"phases_", ",", " ", 
       RowBox[{"delta_", " ", ":", " ", "0.01"}]}], "]"}], " ", ":=", "\n", 
     "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ord", ",", " ", "sp", ",", " ", "n", ",", " ", "breaks", ",", " ", 
         "starts", ",", " ", "ends", ",", " ", "slices"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{
        RowBox[{"ord", " ", "=", " ", 
         RowBox[{"Ordering", "[", "phases", "]"}]}], ";", "\n", "    ", 
        RowBox[{"sp", "  ", "=", " ", 
         RowBox[{"phases", "[", 
          RowBox[{"[", "ord", "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"n", "   ", "=", " ", 
         RowBox[{"Length", "[", "sp", "]"}]}], ";", "\n", "    ", 
        RowBox[{"breaks", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"n", " ", "-", " ", "1"}], "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"sp", "[", 
               RowBox[{"[", 
                RowBox[{"#", " ", "+", " ", "1"}], "]"}], "]"}], " ", "-", 
              " ", 
              RowBox[{"sp", "[", 
               RowBox[{"[", "#", "]"}], "]"}]}], " ", ">", " ", "delta"}], 
            " ", "&"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"starts", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"breaks", " ", "+", " ", "1"}], ",", " ", "1"}], "]"}]}], ";",
         "\n", "    ", 
        RowBox[{"ends", "   ", "=", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"breaks", ",", " ", "n"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"slices", " ", "=", " ", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Range", ",", " ", 
           RowBox[{"{", 
            RowBox[{"starts", ",", " ", "ends"}], "}"}]}], "]"}]}], ";", "\n",
         "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"2", " ", "Pi"}], " ", "-", " ", 
            RowBox[{"sp", "[", 
             RowBox[{"[", "n", "]"}], "]"}], " ", "+", " ", 
            RowBox[{"sp", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], " ", "<", " ", "delta"}], ",", 
          "\n", "      ", 
          RowBox[{"slices", " ", "=", " ", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"slices", "[", 
              RowBox[{"[", 
               RowBox[{"2", " ", ";;", " ", 
                RowBox[{"-", "2"}]}], "]"}], "]"}], ",", " ", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"slices", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"slices", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}]}]}], "]"}], ";",
         "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"ord", "[", 
           RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "slices"}]}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Splits", " ", "the", " ", "merged", " ", "husimiValues", " ", "matrix", " ",
      "by", " ", "parity", " ", "sector"}], " ", "*)"}], "\n", 
