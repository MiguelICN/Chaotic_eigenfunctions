Cell[BoxData[{
 RowBox[{
  RowBox[{"s", " ", "=", " ", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"targets", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"p", " ", "*", " ", 
       RowBox[{"Pi", " ", "/", " ", "s"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "0", ",", " ", 
        RowBox[{
         RowBox[{"2", "s"}], " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "wrap", " ", "distance", " ", "accounting", " ", "for", " ", "2", "\[Pi]", 
    " ", "periodicity"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"delta", " ", "=", " ", 
   RowBox[{"Map", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"#", " ", "-", " ", "targets"}], "]"}], "]"}], ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"#", " ", "-", " ", "targets", " ", "-", " ", 
           RowBox[{"2", "Pi"}]}], "]"}], "]"}], ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"#", " ", "-", " ", "targets", " ", "+", " ", 
           RowBox[{"2", "Pi"}]}], "]"}], "]"}]}], "]"}], " ", "&"}], ",", 
     "\n", "  ", "quasienergies"}], "\n", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.986637325228945*^9},
 CellLabel->
  "In[141]:=",ExpressionUUID->"95fd26be-374e-fe42-8ab7-dfac469aefc4"],

