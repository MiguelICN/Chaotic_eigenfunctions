  "In[309]:=",ExpressionUUID->"60388e55-6eeb-ad43-892a-3c6b3ea3b055"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nPlot", " ", "=", " ", "50"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sortedIdx", " ", "=", " ", 
   RowBox[{"Ordering", "[", "compositeRank", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"selectedIdx", " ", "=", " ", 
    RowBox[{"Take", "[", 
     RowBox[{"sortedIdx", ",", " ", "nPlot"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dir", " ", "=", " ", "\"\<HusimiSorted\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", " ", 
     RowBox[{"CreateDirectory", "[", "dir", "]"}]}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Distribute", " ", "shared", " ",
     "data", " ", "to", " ", "all", " ", "kernels", " ", 
    "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"DistributeDefinitions", "[", 
   RowBox[{
   "region", ",", " ", "husimi", ",", " ", "quasienergies", ",", " ", 
    "shannonEntropy", ",", " ", "iprEigen", ",", " ", "selectedIdx", ",", " ",
     "dir", ",", " ", "nPlot"}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[313]:=",ExpressionUUID->"63273bbe-bdeb-e54c-b3d9-af7c721672ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ParallelDo", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "idx", ",", " ", "husimiList", ",", " ", "plot", ",", " ", "fname"}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"idx", " ", "=", " ", 
        RowBox[{"selectedIdx", "[", 
         RowBox[{"[", "n", "]"}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"husimiList", " ", "=", " ", 
        RowBox[{"MapThread", "[", 
         RowBox[{"Append", ",", " ", 
          RowBox[{"{", 
           RowBox[{"region", ",", " ", 
            RowBox[{"husimi", "[", 
             RowBox[{"[", "idx", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"plot", " ", "=", " ", 
        RowBox[{"ListDensityPlot", "[", 
         RowBox[{"husimiList", ",", "\n", "      ", 
          RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "      ", 
          RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", 
          "\n", "      ", 
          RowBox[{
          "ColorFunction", " ", "->", " ", "\"\<BlueGreenYellow\>\""}], ",", 
          "\n", "      ", 
          RowBox[{"InterpolationOrder", " ", "->", " ", "1"}], ",", "\n", 
          "      ", 
          RowBox[{"AspectRatio", " ", "->", " ", "1"}], ",", "\n", "      ", 
          RowBox[{"ImageSize", " ", "->", " ", "800"}], ",", "\n", "      ", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "      ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Q\>\"", ",", " ", "30", ",", " ", "Black"}], "]"}],
              ",", " ", 
             RowBox[{"Rotate", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<P\>\"", ",", " ", "30", ",", " ", "Black"}], 
                "]"}], ",", " ", 
               RowBox[{
                RowBox[{"-", "90"}], " ", "Degree"}]}], "]"}]}], "}"}]}], ",",
           "\n", "      ", 
          RowBox[{"LabelStyle", " ", "->", " ", 
           RowBox[{"Directive", "[", 
            RowBox[{"20", ",", " ", "Black"}], "]"}]}], ",", "\n", "      ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"Style", "[", "\n", "        ", 
            RowBox[{
             RowBox[{"\"\<rank=\>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "n", "]"}], " ", "<>", "\n", 
              "        ", "\"\<  q = \>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "idx", "]"}], " ", "<>", "\n", 
              "        ", "\"\<  \[CurlyPhi] = \>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"quasienergies", "[", 
                  RowBox[{"[", "idx", "]"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"5", ",", "3"}], "}"}]}], "]"}], "]"}], " ", "<>", 
              "\n", "        ", "\"\<  S = \>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"shannonEntropy", "[", 
                  RowBox[{"[", "idx", "]"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"5", ",", "3"}], "}"}]}], "]"}], "]"}], " ", "<>", 
              "\n", "        ", "\"\<  IPR = \>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", 
               RowBox[{"NumberForm", "[", 
                RowBox[{
                 RowBox[{"iprEigen", "[", 
                  RowBox[{"[", "idx", "]"}], "]"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"4", ",", "3"}], "}"}]}], "]"}], "]"}]}], ",", "\n",
              "        ", "18", ",", " ", "Black"}], "]"}]}]}], "\n", "    ", 
         "]"}]}], ";", "\n", "    ", 
       RowBox[{"fname", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dir", ",", "\n", "      ", 
           RowBox[{"\"\<rank\>\"", " ", "<>", " ", 
            RowBox[{"IntegerString", "[", 
             RowBox[{"n", ",", " ", "10", ",", " ", "3"}], "]"}], " ", "<>", 
            "\n", "      ", "\"\<_q\>\"", " ", "<>", " ", 
