       "                     ", "\"\<  J = \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "J", "]"}]}], ",", " ", "15", ",", " ", 
      "Black"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
