Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "groupDir", "}"}], ",", 
        RowBox[{
         RowBox[{"groupDir", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"dir", ",", "sector", ",", 
             RowBox[{"\"\<Group_\>\"", "<>", 
              RowBox[{"ToString", "[", "g", "]"}]}]}], "}"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"DirectoryQ", "[", "groupDir", "]"}]}], ",", 
           RowBox[{"CreateDirectory", "[", "groupDir", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"idx", ",", "husimiList", ",", "plot"}], "}"}], ",", 
             RowBox[{
              RowBox[{"idx", "=", 
               RowBox[{
                RowBox[{"groupIndices", "[", "sector", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"g", ",", "i"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"husimiList", "=", 
               RowBox[{"MapThread", "[", 
                RowBox[{"Append", ",", 
                 RowBox[{"{", 
                  RowBox[{"region", ",", 
                   RowBox[{
                    RowBox[{"husimiSectors", "[", "sector", "]"}], "[", 
                    RowBox[{"[", "idx", "]"}], "]"}]}], "}"}]}], "]"}]}], ";",
               "\[IndentingNewLine]", 
              RowBox[{"plot", "=", 
               RowBox[{"ListDensityPlot", "[", 
                RowBox[{"husimiList", ",", 
                 RowBox[{"PlotRange", "->", "All"}], ",", 
                 RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
                 RowBox[{"ColorFunction", "->", "\"\<BlueGreenYellow\>\""}], ",", 
                 RowBox[{"PlotLabel", "->", 
                  RowBox[{"Style", "[", 
                   RowBox[{
                    RowBox[{"\"\<Husimi, J = \>\"", "<>", 
                    RowBox[{"ToString", "[", "J", "]"}], 
                    "<>", "\"\<, \[Alpha] = \>\"", "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"N", "[", "\[Alpha]", "]"}], "]"}], 
                    "<>", "\"\<, k = \>\"", "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{"k", ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "2"}], "}"}]}], "]"}], "]"}], 
                    "<>", "\"\<, \>\"", "<>", "sector", 
                    "<>", "\"\< Group \>\"", "<>", 
                    RowBox[{"ToString", "[", "g", "]"}], "<>", "\"\< (\>\"", "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"Length", "[", 
                    RowBox[{
                    RowBox[{"groupIndices", "[", "sector", "]"}], "[", 
                    RowBox[{"[", "g", "]"}], "]"}], "]"}], "]"}], 
                    "<>", "\"\< states)\>\"", "<>", "\"\<, State \>\"", "<>", 
                    RowBox[{"ToString", "[", "idx", "]"}]}], ",", "25", ",", 
                    "Black"}], "]"}]}], ",", 
                 RowBox[{"ImageSize", "->", "1000"}], ",", 
                 RowBox[{"FrameLabel", "->", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Q\>\"", ",", "40", ",", "Black"}], "]"}], ",", 
                    RowBox[{"Rotate", "[", 
                    RowBox[{
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<P\>\"", ",", "40", ",", "Black"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"-", "90"}], " ", "Degree"}]}], "]"}]}], "}"}]}], 
                 ",", 
                 RowBox[{"LabelStyle", "->", 
                  RowBox[{"Directive", "[", 
                   RowBox[{"30", ",", "Black"}], "]"}]}], ",", 
                 RowBox[{"AspectRatio", "->", "1"}], ",", 
                 RowBox[{"Frame", "->", "True"}], ",", 
                 RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"Export", "[", 
               RowBox[{
                RowBox[{"FileNameJoin", "[", 
                 RowBox[{"{", 
                  RowBox[{"groupDir", ",", 
                   
                   RowBox[{"\"\<Husimi_\>\"", "<>", "sector", 
                    "<>", "\"\<_state_\>\"", "<>", 
                    RowBox[{"ToString", "[", "idx", "]"}], 
                    "<>", "\"\<.png\>\""}]}], "}"}], "]"}], ",", "plot"}], 
               "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", 
              RowBox[{
               RowBox[{"groupIndices", "[", "sector", "]"}], "[", 
               RowBox[{"[", "g", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"g", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"groupIndices", "[", "sector", "]"}], "]"}]}], "}"}]}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"sector", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Even\>\"", ",", "\"\<Odd\>\""}], "}"}]}], "}"}]}], "]"}], 
  ";"}]], "Input",
