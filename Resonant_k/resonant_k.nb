Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MultipoleStrengthFast", "[", 
    RowBox[{"state_", ",", " ", "S_", ",", " ", "K_"}], "]"}], " ", ":=", 
   "\n", "  ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "\n", "    ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{"state", "[", 
            RowBox[{"[", 
             RowBox[{"S", "+", "m", "+", "1"}], "]"}], "]"}], "]"}], " ", 
          RowBox[{"state", "[", 
           RowBox[{"[", 
            RowBox[{"S", "+", 
             RowBox[{"(", 
              RowBox[{"m", "-", "Q"}], ")"}], "+", "1"}], "]"}], "]"}], " ", "*",
           "\n", "        ", 
          RowBox[{"ClebschGordan", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"S", ",", " ", 
              RowBox[{"m", "-", "Q"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"K", ",", " ", "Q"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"S", ",", " ", "m"}], "}"}]}], "]"}]}], ",", "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"-", "S"}], ",", " ", 
             RowBox[{
              RowBox[{"-", "S"}], "+", "Q"}]}], "]"}], ",", " ", 
           RowBox[{"Min", "[", 
            RowBox[{"S", ",", " ", 
             RowBox[{"S", "+", "Q"}]}], "]"}]}], "}"}]}], "]"}], "]"}], "^", 
      "2"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"Q", ",", " ", 
       RowBox[{"-", "K"}], ",", " ", "K"}], "}"}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
