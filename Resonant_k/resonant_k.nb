Cell[CellGroupData[{

Cell["Hypothesis 2", "Title",
 CellChangeTimes->{{3.986641419013479*^9, 
  3.986641420911888*^9}},ExpressionUUID->"1e730abd-9a8e-5941-a2c2-\
09faf129a21b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Free", " ", "parameters", " ", 
    "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"J", " ", "=", " ", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alphaCenter", " ", "=", " ", 
     RowBox[{"Pi", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"J", " ", "*", " ", "Pi", " ", "*", " ", 
      RowBox[{"(", 
       RowBox[{"2", "/", "5."}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alphaRange", " ", "=", " ", "0.1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alphaStep", "  ", "=", " ", "0.0005"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nTarget", "    ", "=", "5"}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "adjust", " ", "based", " ", "on", " ", "Hypothesis", " ", "1", " ", 
     "output"}], " ", "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9866415058875046`*^9, 3.9866415347620144`*^9}},
 CellLabel->
  "In[477]:=",ExpressionUUID->"21bb948b-11d2-534e-a257-acaf6de3948b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Scan", " ", 
    "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"alphaList", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"alphaCenter", " ", "-", " ", "alphaRange"}], ",", " ", 
       RowBox[{"alphaCenter", " ", "+", " ", "alphaRange"}], ",", " ", 
       "alphaStep"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "GetQKTParityEigensystem", ",", " ", "J", ",", " ", "k", ",", " ", 
      "alphaList", ",", " ", "nTarget"}], "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[483]:=",ExpressionUUID->"4713358e-55ac-4141-9e0d-126a6c2f3299"],

Cell[BoxData[
 RowBox[{
  RowBox[{"scanResults", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Fmat", " ", "=", " ", 
         RowBox[{"Floqsym", "[", 
          RowBox[{"J", ",", "\[Alpha]", ",", "k"}], "]"}]}], "}"}], ",", "\n",
        "    ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Fn", " ", "=", " ", 
           RowBox[{"MatrixPower", "[", 
            RowBox[{"Fmat", ",", " ", "nTarget"}], "]"}]}], "}"}], ",", "\n", 
         "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"gamma", " ", "=", " ", 
             RowBox[{"Arg", "[", 
              RowBox[{
               RowBox[{"Tr", "[", "Fn", "]"}], " ", "/", " ", 
               RowBox[{"Length", "[", "Fmat", "]"}]}], "]"}]}], "}"}], ",", 
           "\n", "        ", 
           RowBox[{"{", 
            RowBox[{"a", ",", " ", 
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"Fn", " ", "-", " ", 
                RowBox[{
                 RowBox[{"Exp", "[", 
                  RowBox[{"I", " ", "gamma"}], "]"}], " ", "*", " ", 
                 RowBox[{"IdentityMatrix", "[", 
                  RowBox[{"Length", "[", "Fmat", "]"}], "]"}]}]}], ",", 
               " ", "\"\<Frobenius\>\""}], "]"}]}], "}"}]}], "\n", "      ", 
          "]"}]}], "\n", "    ", "]"}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "alphaList"}], "}"}], ",", "\n", "  ", 
     RowBox[{"Method", " ", "->", " ", "\"\<CoarsestGrained\>\""}]}], "\n", 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.9866414790036983`*^9},
 CellLabel->
  "In[485]:=",ExpressionUUID->"f89a80d5-2844-2f43-bc61-7f24cb43ed3a"],

