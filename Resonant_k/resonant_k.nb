Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"should", " ", "be", " ", "2", "J"}], "+", "1"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"plots", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"husimiList", ",", "plot"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"husimiList", "=", 
          RowBox[{"MapThread", "[", 
           RowBox[{"Append", ",", 
            RowBox[{"{", 
             RowBox[{"region", ",", 
              RowBox[{"husimiValuesSorted", "[", 
               RowBox[{"[", "q", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"plot", "=", 
          RowBox[{"ListDensityPlot", "[", 
           RowBox[{"husimiList", ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
            RowBox[{"ColorFunction", "->", "\"\<BlueGreenYellow\>\""}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"\"\<Husimi, J = \>\"", "<>", 
                RowBox[{"ToString", "[", "J", "]"}], 
                "<>", "\"\<, \[Alpha] = \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"N", "[", "\[Alpha]", "]"}], "]"}], 
                "<>", "\"\<, k = \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{"k", ",", 
                   RowBox[{"{", 
                    RowBox[{"4", ",", "2"}], "}"}]}], "]"}], "]"}], 
                "<>", "\"\<, Eigenvec_q = \>\"", "<>", 
                RowBox[{"ToString", "[", "q", "]"}]}], ",", "25", ",", 
               "Black"}], "]"}]}], ",", 
            RowBox[{"ImageSize", "->", "1000"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Q\>\"", ",", "40", ",", "Black"}], "]"}], ",", 
               RowBox[{"Rotate", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"\"\<P\>\"", ",", "40", ",", "Black"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"-", "90"}], " ", "Degree"}]}], "]"}]}], "}"}]}], ",", 
            RowBox[{"LabelStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"30", ",", "Black"}], "]"}]}], ",", 
            RowBox[{"AspectRatio", "->", "1"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", 
              RowBox[{"\"\<Husimi_J_\>\"", "<>", 
               RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<_q\>\"", "<>", 
               RowBox[{"ToString", "[", "q", "]"}], "<>", "\"\<.png\>\""}]}], 
             "}"}], "]"}], ",", "plot"}], "]"}], ";", "\[IndentingNewLine]", 
         "plot"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"q", ",", "1", ",", 
        RowBox[{
         RowBox[{"2", "J"}], "+", "1"}], ",", "100"}], "}"}]}], "]"}]}], 
   ";"}]}]], "Input",
