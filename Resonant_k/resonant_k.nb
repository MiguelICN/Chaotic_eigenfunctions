Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Composite", " ", 
    "localization", " ", "score", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"rank", " ", "each", " ", "criterion"}], ",", " ", 
      RowBox[{"sum", " ", "ranks"}]}], ")"}], " ", 
    "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rankIPR", "     ", "=", " ", 
     RowBox[{"Ordering", "[", 
      RowBox[{"Ordering", "[", 
       RowBox[{"-", "iprEigen"}], "]"}], "]"}]}], ";"}], "      ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"high", " ", "IPR"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"more", " ", "localized"}], " ", "\[RightArrow]", " ", 
      RowBox[{
       RowBox[{"rank", " ", "ascending", " ", "by"}], " ", "-", "IPR"}]}]}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rankEntropy", " ", "=", " ", 
     RowBox[{"Ordering", "[", 
      RowBox[{"Ordering", "[", "shannonEntropy", "]"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"low", " ", "entropy"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"more", " ", "localized"}], " ", "\[RightArrow]", " ", 
      RowBox[{"rank", " ", "ascending"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rankMoment", "  ", "=", " ", 
     RowBox[{"Ordering", "[", 
      RowBox[{"Ordering", "[", "secondMoment", "]"}], "]"}]}], ";"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"low", " ", "moment"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"more", " ", "localized"}], " ", "\[RightArrow]", " ", 
      RowBox[{"rank", " ", "ascending"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"compositeRank", " ", "=", " ", 
     RowBox[{
     "rankIPR", " ", "+", " ", "rankEntropy", " ", "+", " ", "rankMoment"}]}],
     ";"}]}]}]], "Input",
 CellChangeTimes->{
  3.9866360994007645`*^9, {3.9866362720338993`*^9, 3.986636276061346*^9}, {
   3.986636809283476*^9, 3.9866368108621445`*^9}},
