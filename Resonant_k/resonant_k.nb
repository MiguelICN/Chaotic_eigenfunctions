Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\[HorizontalLine]\[HorizontalLine]", " ", "Quasienergies", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"both", " ", "parities"}], ",", " ", 
      RowBox[{"same", " ", "order", " ", "as", " ", "neweigenvec"}]}], ")"}], 
    " ", "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"quasienergies", " ", "=", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"\"\<Even\>\"", ",", " ", "\"\<Phases\>\""}], "]"}], ",", " ", 
       RowBox[{"data", "[", 
        RowBox[{"\"\<Odd\>\"", ",", " ", "\"\<Phases\>\""}], "]"}]}], "]"}]}],
     ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[HorizontalLine]\[HorizontalLine]", " ", "Husimi", " ", 
       RowBox[{"values", ":", " ", "rows"}]}], " ", "=", " ", "eigenstates"}],
      ",", " ", 
     RowBox[{"cols", " ", "=", " ", 
      RowBox[{"phase", "-", 
       RowBox[{
       "space", " ", "points", " ", 
        "\[HorizontalLine]\[HorizontalLine]"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"husimi", " ", "=", " ", 
     RowBox[{
      RowBox[{"Abs", "[", "overlaps", "]"}], "^", "2"}]}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"already", " ", "normalized", " ", "per", " ", "row"}], " ", 
    "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "\[HorizontalLine]\[HorizontalLine]", " ", "1.", " ", "IPR", " ", "of", " ",
      "each", " ", "eigenstate", " ", "over", " ", "phase", " ", "space", " ",
      "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"iprEigen", " ", "=", " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"husimi", "^", "2"}], ",", " ", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "\[HorizontalLine]\[HorizontalLine]", " ", "2.", " ", "Shannon", " ", 
     "entropy", " ", "of", " ", "each", " ", "eigenstate", " ", 
     "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"shannonEntropy", " ", "=", " ", 
     RowBox[{"-", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"husimi", " ", "*", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"husimi", " ", "+", " ", "$MachineEpsilon"}], "]"}]}], ",", 
        " ", 
        RowBox[{"{", "2", "}"}]}], "]"}]}]}], ";"}]}]}]], "Input",
