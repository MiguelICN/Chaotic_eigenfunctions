Cell[CellGroupData[{

Cell["Hypothesis 1", "Title",
 CellChangeTimes->{{3.9866410750373344`*^9, 
  3.9866410787386227`*^9}},ExpressionUUID->"66a22817-685b-6841-80e1-\
1325f999b97a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Free", " ", "parameters", " ", 
    "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"J", " ", "=", " ", "500"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alphaTest", " ", "=", " ", 
     RowBox[{"Pi", " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2.", "]"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"k", " ", "=", " ", 
     RowBox[{"J", " ", "*", " ", "Pi", " ", "*", " ", 
      RowBox[{"(", 
       RowBox[{"2", "/", "5."}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nMax", " ", "=", " ", "J"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9866412293034954`*^9, 3.986641229524481*^9}, {
   3.9866412672119427`*^9, 3.9866413246917973`*^9}, 3.986641356629076*^9, {
   3.9866479968831215`*^9, 3.986647997246788*^9}},
 CellLabel->
  "In[175]:=",ExpressionUUID->"d830c166-befa-1443-942f-537b925fe7c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "\[HorizontalLine]\[HorizontalLine]", " ", "Build", " ", "full", " ", 
    "Floquet", " ", "matrix", " ", "\[HorizontalLine]\[HorizontalLine]"}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Fmat", " ", "=", 
     RowBox[{"Floqsym", "[", 
      RowBox[{"J", ",", "\[Alpha]", ",", "k"}], "]"}]}], " ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"your", " ", 
       RowBox[{"pipeline", "'"}], "s", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "J"}], "+", "1"}], ")"}]}], "-", 
      RowBox[{"dimensional", " ", "Floquet", " ", "unitary"}]}], " ", "*)"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"identity", " ", "=", " ", 
     RowBox[{"IdentityMatrix", "[", 
      RowBox[{"Length", "[", "Fmat", "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[179]:=",ExpressionUUID->"27cdb2cc-4c8a-da4f-9b35-54f7b5ec395e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"\[HorizontalLine]\[HorizontalLine]", " ", "Compute"}], " ", "||", 
    RowBox[{
     RowBox[{"F", "^", "n"}], " ", "-", " ", 
     RowBox[{
      RowBox[{"e", "^", 
       RowBox[{"{", "i\[Gamma]", "}"}]}], "I"}]}], "||", " ", 
    RowBox[{
    "minimized", " ", "over", " ", "\[Gamma]", " ", "for", " ", "each", " ", 
     "n", " ", "\[HorizontalLine]\[HorizontalLine]"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"recurrenceNorms", " ", "=", 
    RowBox[{"ParallelTable", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Fn", " ", "=", " ", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"Fmat", ",", " ", "n"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"gamma", " ", "=", " ", 
        RowBox[{"Arg", "[", 
         RowBox[{
          RowBox[{"Tr", "[", "Fn", "]"}], " ", "/", " ", 
          RowBox[{"Length", "[", "Fmat", "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"Fn", " ", "-", " ", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", " ", "gamma"}], "]"}], " ", "*", " ", 
             "identity"}]}], ",", " ", "\"\<Frobenius\>\""}], "]"}]}], 
        "}"}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "1", ",", " ", "nMax"}], "}"}]}], "\n", "]"}]}],
    ";"}]}]], "Input",
 CellChangeTimes->{
  3.98664131114106*^9, {3.986648175702488*^9, 3.986648177974863*^9}},
 CellLabel->
  "In[182]:=",ExpressionUUID->"f22d4a6e-6d03-9340-a526-92df2507d8e9"],

Cell[BoxData["$Aborted"], "Output",
 CellChangeTimes->{3.9866480070877075`*^9, 3.986648170186264*^9, 
  3.9866482648232803`*^9},
