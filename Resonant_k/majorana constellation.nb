          RowBox[{"Pi", "/", 
           RowBox[{"Sqrt", "[", "8", "]"}]}]}], ",", " ", "k", ",", " ", "U", 
         ",", " ", "eigs", ",", " ", "U5", ",", " ", "U10"}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{
        RowBox[{"d", " ", "=", " ", 
