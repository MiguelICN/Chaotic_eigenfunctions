          RowBox[{"-", "2"}], " ", 
          RowBox[{"Im", "[", "z", "]"}]}], ",", " ", 
         RowBox[{"1", " ", "-", " ", "r2"}]}], "}"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "r2"}], ")"}]}]}], "]"}]}]}]}]], "Input",
