      "\n", "    ", 
      RowBox[{
       RowBox[{"finite", "  ", "=", " ", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{"stars", ",", " ", 
          RowBox[{"_DirectedInfinity", " ", "|", " ", "ComplexInfinity"}]}], 
         "]"}]}], ";", "\n", "    ", 
       RowBox[{"coeffs", "  ", "=", " ", 
        RowBox[{"PadRight", "[", "\n", "                ", 
         RowBox[{
          RowBox[{"CoefficientList", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{"Product", "[", 
              RowBox[{
               RowBox[{"z", " ", "-", " ", "s"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"s", ",", " ", "finite"}], "}"}]}], "]"}], "]"}], ",",
             " ", "z"}], "]"}], ",", "\n", "                ", 
          RowBox[{
           RowBox[{"2", "S"}], " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"state", "   ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"coeffs", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "/", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"N", "[", 
             RowBox[{"Binomial", "[", 
              RowBox[{
               RowBox[{"2", "S"}], ",", " ", "k"}], "]"}], "]"}], "]"}]}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "0", ",", " ", 
            RowBox[{"2", "S"}]}], "}"}]}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"state", " ", "/", " ", 
        RowBox[{"Norm", "[", "state", "]"}]}]}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Stereographic", " ", "\[LeftRightArrow]", " ", 
     RowBox[{"Cartesian", " ", 
      RowBox[{"conversions", " ", "[", 
       RowBox[{"Eq", ".", " ", "2.3"}], "]"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"CartesianToStereo", "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "zc_"}], "}"}], "]"}], " ", ":=",
     "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"1", " ", "+", " ", "zc"}], "]"}], " ", "<", " ", "1*^-10"}], 
      ",", " ", "ComplexInfinity", ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "-", " ", 
         RowBox[{"I", " ", "y"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "zc"}], ")"}]}]}], "]"}]}], "\n", "\n", 
   RowBox[{
    RowBox[{"StereoToCartesian", "[", "z_", "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r2", " ", "=", " ", 
        RowBox[{
         RowBox[{"Abs", "[", "z", "]"}], "^", "2"}]}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"Re", "[", "z", "]"}]}], ",", " ", 
