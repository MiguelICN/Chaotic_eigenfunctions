Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", " ", "Small"}]}], "-", 
    RowBox[{"j", " ", 
     RowBox[{
      RowBox[{"exploration", " ", "--"}], "--"}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"Do", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"j", " ", "=", " ", "jval"}], ",", " ", "d", ",", " ", 
