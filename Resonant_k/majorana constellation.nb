Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Optimize", " ", "\[Theta]", "*", " ", "so", " ", "that", " ", "w_", "1", " ",
     "through", " ", "w_", "5", " ", "are", " ", "simultaneously", " ", 
