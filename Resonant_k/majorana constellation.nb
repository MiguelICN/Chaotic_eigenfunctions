      " ", 
     RowBox[{
      RowBox[{"state", " ", "is", " ", "a", " ", "length"}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "S"}], "+", "1"}], ")"}], " ", "vector"}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"HusimiQ", "[", 
     RowBox[{
     "state_", ",", " ", "S_", ",", " ", "\[Theta]_", ",", " ", 
      "\[CurlyPhi]_"}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", 
        RowBox[{"CoherentStateSpin", "[", 
         RowBox[{"S", ",", " ", "\[Theta]", ",", " ", "\[CurlyPhi]"}], "]"}], 
        "]"}], " ", ".", " ", "state"}], "]"}], "^", "2"}]}]}]}]], "Input",
