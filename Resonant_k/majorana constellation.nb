       RowBox[{"hpState", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"state", ",", "30"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"poly", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"2", "S"}], ",", "k"}], "]"}], "]"}], " ", 
           RowBox[{"hpState", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
           RowBox[{"var", "^", "k"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{"2", "S"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"var", "/.", " ", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{"poly", "==", "0"}], ",", "var", ",", 
          RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}]}], "]"}]}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Reconstruct", " ", "normalized", " ", "state", " ", "from", " ", "stars",
      " ", "in", " ", "stereographic", " ", 
     RowBox[{"coords", ".", "\n", "   ", "Pass"}], " ", "ComplexInfinity", " ",
      "for", " ", "any", " ", "star", " ", "located", " ", "at", " ", "the", " ",
      "south", " ", 
     RowBox[{"pole", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"StateFromStars", "[", 
     RowBox[{"stars_", ",", " ", "S_"}], "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"finite", ",", " ", "coeffs", ",", " ", "state"}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{
       RowBox[{"finite", "  ", "=", " ", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{"stars", ",", " ", 
          RowBox[{"_DirectedInfinity", " ", "|", " ", "ComplexInfinity"}]}], 
         "]"}]}], ";", "\n", "    ", 
       RowBox[{"coeffs", "  ", "=", " ", 
        RowBox[{"PadRight", "[", "\n", "                ", 
         RowBox[{
          RowBox[{"CoefficientList", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{"Product", "[", 
              RowBox[{
               RowBox[{"z", " ", "-", " ", "s"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"s", ",", " ", "finite"}], "}"}]}], "]"}], "]"}], ",",
             " ", "z"}], "]"}], ",", "\n", "                ", 
          RowBox[{
           RowBox[{"2", "S"}], " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
       "    ", 
       RowBox[{"state", "   ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"coeffs", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "/", " ", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"N", "[", 
             RowBox[{"Binomial", "[", 
              RowBox[{
               RowBox[{"2", "S"}], ",", " ", "k"}], "]"}], "]"}], "]"}]}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "0", ",", " ", 
            RowBox[{"2", "S"}]}], "}"}]}], "]"}]}], ";", "\n", "    ", 
       RowBox[{"state", " ", "/", " ", 
        RowBox[{"Norm", "[", "state", "]"}]}]}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Stereographic", " ", "\[LeftRightArrow]", " ", 
     RowBox[{"Cartesian", " ", 
      RowBox[{"conversions", " ", "[", 
       RowBox[{"Eq", ".", " ", "2.3"}], "]"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"CartesianToStereo", "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "zc_"}], "}"}], "]"}], " ", ":=",
     "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"1", " ", "+", " ", "zc"}], "]"}], " ", "<", " ", "1*^-10"}], 
      ",", " ", "ComplexInfinity", ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "-", " ", 
         RowBox[{"I", " ", "y"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "zc"}], ")"}]}]}], "]"}]}], "\n", "\n", 
   RowBox[{
    RowBox[{"StereoToCartesian", "[", "z_", "]"}], " ", ":=", "\n", "  ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r2", " ", "=", " ", 
        RowBox[{
         RowBox[{"Abs", "[", "z", "]"}], "^", "2"}]}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"Re", "[", "z", "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          RowBox[{"Im", "[", "z", "]"}]}], ",", " ", 
         RowBox[{"1", " ", "-", " ", "r2"}]}], "}"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "r2"}], ")"}]}]}], "]"}]}]}]}]], "Input",
