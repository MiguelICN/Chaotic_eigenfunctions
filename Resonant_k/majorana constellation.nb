           " ", 
          RowBox[{"{", 
           RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", 
            RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "\n", "      ", 
          RowBox[{"Method", " ", "->", " ", "\"\<GlobalAdaptive\>\""}], ",", 
          " ", 
          RowBox[{"MaxRecursion", " ", "->", " ", "20"}]}], "]"}], "]"}], "^",
        "2"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", 
        RowBox[{"-", "K"}], ",", " ", "K"}], "}"}]}], "]"}]}]}]}]], "Input",
