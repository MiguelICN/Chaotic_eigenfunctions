Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Stellar", " ", "polynomial", " ", "f_\[Psi]", 
     RowBox[{
      RowBox[{"(", "z", ")"}], " ", "[", 
      RowBox[{"Eq", ".", " ", "2.9"}], "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"state", "[", 
      RowBox[{"[", 
       RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "\[LeftRightArrow]", " ", 
     RowBox[{"\[Psi]_", 
