Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Pentagonal", " ", "antiprism", " ", "stars", " ", "at", " ", "latitude", 
     " ", "\[Theta]", "*"}], ",", " ", 
    RowBox[{"offset", " ", 
     RowBox[{"\[Pi]", "/", "5"}], " ", "between", " ", "rings"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"PentagonalAntiprismStars", "[", "\[Theta]_", "]"}], " ", ":=", 
    "\n", "  ", 
    RowBox[{"Join", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", "\[Pi]", " ", 
             RowBox[{"k", "/", "5"}]}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"2", "\[Pi]", " ", 
             RowBox[{"k", "/", "5"}]}], "]"}]}], ",", "  ", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"2", "\[Pi]", " ", 
              RowBox[{"k", "/", "5"}]}], " ", "+", " ", 
             RowBox[{"\[Pi]", "/", "5"}]}], "]"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"2", "\[Pi]", " ", 
              RowBox[{"k", "/", "5"}]}], " ", "+", " ", 
             RowBox[{"\[Pi]", "/", "5"}]}], "]"}]}], ",", " ", 
          RowBox[{"-", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], 
     "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Multipole", " ", "strength", " ", "w_K", " ", "for", " ", "a", " ", 
      "given", " ", 
      RowBox[{"state", " ", "[", 
       RowBox[{"Eq", ".", " ", "4.7"}], "]"}]}], " ", "\[LongDash]", " ", 
     "\n", "   ", 
     RowBox[{
     "numerical", " ", "integration", " ", "of", " ", "Q", " ", "against", " ",
       "spherical", " ", "harmonics"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"MultipoleStrength", "[", 
     RowBox[{"state_", ",", " ", "S_", ",", " ", "K_"}], "]"}], " ", ":=", 
    "\n", "  ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"NIntegrate", "[", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"HusimiQ", "[", 
            RowBox[{
            "state", ",", " ", "S", ",", " ", "\[Theta]", ",", " ", 
             "\[CurlyPhi]"}], "]"}], " ", 
           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{
            "K", ",", " ", "q", ",", " ", "\[Theta]", ",", " ", 
             "\[CurlyPhi]"}], "]"}], " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "\n", "      ", 
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", " ", "0", ",", " ", "\[Pi]"}], "}"}], ",",
           " ", 
          RowBox[{"{", 
           RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", 
            RowBox[{"2", "\[Pi]"}]}], "}"}], ",", "\n", "      ", 
          RowBox[{"Method", " ", "->", " ", "\"\<GlobalAdaptive\>\""}], ",", 
          " ", 
          RowBox[{"MaxRecursion", " ", "->", " ", "20"}]}], "]"}], "]"}], "^",
        "2"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"q", ",", " ", 
        RowBox[{"-", "K"}], ",", " ", "K"}], "}"}]}], "]"}]}]}]}]], "Input",
