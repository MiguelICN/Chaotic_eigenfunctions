       RowBox[{"hpState", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{"state", ",", "30"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"poly", "=", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"Binomial", "[", 
             RowBox[{
              RowBox[{"2", "S"}], ",", "k"}], "]"}], "]"}], " ", 
           RowBox[{"hpState", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
           RowBox[{"var", "^", "k"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{"2", "S"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"var", "/.", " ", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{"poly", "==", "0"}], ",", "var", ",", 
          RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}]}], "]"}]}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Reconstruct", " ", "normalized", " ", "state", " ", "from", " ", "stars",
      " ", "in", " ", "stereographic", " ", 
     RowBox[{"coords", ".", "\n", "   ", "Pass"}], " ", "ComplexInfinity", " ",
      "for", " ", "any", " ", "star", " ", "located", " ", "at", " ", "the", " ",
      "south", " ", 
     RowBox[{"pole", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"StateFromStars", "[", 
