      RowBox[{
      "roots", " ", "of", " ", "f_\[Psi]", " ", "in", " ", "stereographic", " ",
        "coordinates"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"MajoranaStars", "[", 
