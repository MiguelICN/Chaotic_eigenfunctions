Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Stellar", " ", "polynomial", " ", "f_\[Psi]", 
     RowBox[{
      RowBox[{"(", "z", ")"}], " ", "[", 
      RowBox[{"Eq", ".", " ", "2.9"}], "]"}]}], ";", " ", 
    RowBox[{
     RowBox[{"state", "[", 
      RowBox[{"[", 
       RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", "\[LeftRightArrow]", " ", 
     RowBox[{"\[Psi]_", 
      RowBox[{"{", 
       RowBox[{"k", "-", "S"}], "}"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"StellarFunction", "[", 
      RowBox[{"state_", ",", " ", "S_"}], "]"}], "[", "z_", "]"}], " ", ":=", 
    "\n", "  ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"N", "[", 
         RowBox[{
