            RowBox[{"2", "S"}], ",", " ", "k"}], "]"}], ",", " ", "50"}], 
         "]"}], "]"}], " ", 
       RowBox[{"state", "[", 
        RowBox[{"[", 
         RowBox[{"k", "+", "1"}], "]"}], "]"}], " ", 
       RowBox[{"z", "^", "k"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", 
        RowBox[{"2", "S"}]}], "}"}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Majorana", " ", 
