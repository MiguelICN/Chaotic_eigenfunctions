           RowBox[{"SphericalHarmonicY", "[", 
            RowBox[{
            "K", ",", " ", "q", ",", " ", "\[Theta]", ",", " ", 
             "\[CurlyPhi]"}], "]"}], " ", 
           RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "\n", "      ", 
          RowBox[{"{", 
