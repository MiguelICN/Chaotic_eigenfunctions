Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MultipoleStrengthFast", "[", 
    RowBox[{"state_", ",", " ", "S_", ",", " ", "K_"}], "]"}], " ", ":=", 
   "\n", "  ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", "\n", "    ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Conjugate", "[", 
           RowBox[{"state", "[", 
            RowBox[{"[", 
             RowBox[{"S", "+", "m", "+", "1"}], "]"}], "]"}], "]"}], " ", 
          RowBox[{"state", "[", 
           RowBox[{"[", 
            RowBox[{"S", "+", 
             RowBox[{"(", 
              RowBox[{"m", "-", "Q"}], ")"}], "+", "1"}], "]"}], "]"}], " ", "*",
           "\n", "        ", 
          RowBox[{"ClebschGordan", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"S", ",", " ", 
              RowBox[{"m", "-", "Q"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"K", ",", " ", "Q"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"S", ",", " ", "m"}], "}"}]}], "]"}]}], ",", "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", 
           RowBox[{"Max", "[", 
            RowBox[{
             RowBox[{"-", "S"}], ",", " ", 
             RowBox[{
              RowBox[{"-", "S"}], "+", "Q"}]}], "]"}], ",", " ", 
           RowBox[{"Min", "[", 
            RowBox[{"S", ",", " ", 
             RowBox[{"S", "+", "Q"}]}], "]"}]}], "}"}]}], "]"}], "]"}], "^", 
      "2"}], ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{"Q", ",", " ", 
       RowBox[{"-", "K"}], ",", " ", "K"}], "}"}]}], "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"KingState", "[", "5", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[Theta]opt", "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"\[Theta]opt", " ", "=", " ", 
      RowBox[{"\[Theta]", " ", "/.", " ", 
       RowBox[{"Last", "[", 
        RowBox[{"NMinimize", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"MultipoleStrengthFast", "[", "\n", "        ", 
              RowBox[{
               RowBox[{"KingStateFromVertices", "[", 
                RowBox[{
                 RowBox[{"PentagonalAntiprismStars", "[", "\[Theta]", "]"}], ",",
                  " ", "5"}], "]"}], ",", " ", "5", ",", " ", "#"}], "]"}], 
             " ", "&"}], " ", "/@", " ", 
            RowBox[{"Range", "[", 
             RowBox[{"1", ",", " ", "5"}], "]"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"\[Theta]", ",", " ", 
            RowBox[{"\[Pi]", "/", "6"}], ",", " ", 
            RowBox[{"\[Pi]", "/", "2"}]}], "}"}]}], "]"}], "]"}]}]}], ";", 
     "\n", "  ", 
     RowBox[{"KingStateFromVertices", "[", 
      RowBox[{
       RowBox[{"PentagonalAntiprismStars", "[", "\[Theta]opt", "]"}], ",", 
       " ", "5"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{3.987261413407305*^9},
