Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Components", " ", "of"}], " ", "|", "\[Theta]"}], ",", 
    RowBox[{
     RowBox[{"\[CurlyPhi]\:27e9", " ", "in", " ", "the"}], " ", "|", "S"}], ",", 
    RowBox[{"m\:27e9", " ", "basis"}], ",", " ", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"-", "S"}]}], ",", "...", ",", 
    RowBox[{"S", "  ", "[", 
     RowBox[{"Eq", ".", " ", "2.5"}], "]"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"CoherentStateSpin", "[", 
     RowBox[{"S_", ",", "\[Theta]_", ",", "\[CurlyPhi]_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"2", "S"}], ",", 
          RowBox[{"S", "+", "m"}]}], "]"}], "]"}], "*", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"S", "+", "m"}], "==", "0"}], ",", "1", ",", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"S", "+", "m"}], ")"}]}]}], "]"}], "*", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"S", "-", "m"}], "==", "0"}], ",", "1", ",", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"S", "-", "m"}], ")"}]}]}], "]"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], 
         RowBox[{"(", 
          RowBox[{"S", "+", "m"}], ")"}], " ", "\[CurlyPhi]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"-", "S"}], ",", "S"}], "}"}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", 
       RowBox[{"(", 
        RowBox[{"\[Theta]", ",", "\[CurlyPhi]"}], ")"}]}], " ", "=", " ", 
      RowBox[{"|", "\:27e8\[Theta]"}]}], ",", 
