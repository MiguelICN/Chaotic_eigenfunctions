       RowBox[{"z", "^", "k"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", 
        RowBox[{"2", "S"}]}], "}"}]}], "]"}]}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Majorana", " ", 
