Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\:2550\:2550", " ", "High"}], "-", 
    RowBox[{"Performance", " ", "Parity", " ", "Weights", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Vectorized", "&"}], " ", "Parallelized"}], ")"}], " ", 
     "\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"generateParityWeights", "[", 
      RowBox[{"Jval_", ",", "sval_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Rsphere", ",", "logGammaList", ",", "gammaList", ",", "mList", ",", 
         "coeffVec"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Rsphere", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Jval", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "Pi"}], ")"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Shift", " ", "to", " ", "logarithmic", " ", "operations", " ", 
           "to", " ", "prevent", " ", "overflow", " ", "for", " ", "J"}], ">",
           "85"}], "*)"}], 
        RowBox[{"logGammaList", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", "Rsphere", "]"}], "+", 
            RowBox[{"0.5", " ", 
             RowBox[{"Log", "[", 
              RowBox[{"4", " ", "Pi"}], "]"}]}], "+", 
            RowBox[{"LogGamma", "[", 
             RowBox[{
              RowBox[{"2", " ", "Jval"}], "+", "1"}], "]"}], "-", 
            RowBox[{"0.5", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"LogGamma", "[", 
                RowBox[{
                 RowBox[{"2", " ", "Jval"}], "+", "j", "+", "2"}], "]"}], "+", 
               RowBox[{"LogGamma", "[", 
                RowBox[{
                 RowBox[{"2", " ", "Jval"}], "-", "j", "+", "1"}], "]"}]}], 
              ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"2", " ", "Jval"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gammaList", "=", 
         RowBox[{"Exp", "[", "logGammaList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"1.", " ", "Precompute", " ", "the", " ", "j"}], "-", 
          RowBox[{
          "dependent", " ", "terms", " ", "into", " ", "a", " ", "numerical", 
           " ", "vector"}]}], "*)"}], 
        RowBox[{"coeffVec", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", "j"}], "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "j"}], "+", "1"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{"4", " ", "Pi"}], ")"}]}], "]"}], "*", 
             RowBox[{
              RowBox[{"gammaList", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", 
              RowBox[{"(", 
               RowBox[{"-", "sval"}], ")"}]}], "*", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "j"}], "+", "1"}], ")"}], "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "Jval"}], "+", "1"}], ")"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "0", ",", 
              RowBox[{"2", " ", "Jval"}]}], "}"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mList", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "Jval"}], ",", "Jval"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"2.", " ", "Distribute", " ", "the", " ", "m"}], "-", 
          RowBox[{
          "loop", " ", "across", " ", "all", " ", "cores", " ", "and", " ", 
           "use", " ", "fast", " ", "dot", " ", "products"}]}], "*)"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "Rsphere"}], ")"}], "*", 
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", "cgVec", "}"}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"Compute", " ", "the", " ", "Clebsch"}], "-", 
               RowBox[{
