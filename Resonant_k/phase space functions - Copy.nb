Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"\[HorizontalLine]\[HorizontalLine]", " ", "Quasienergies", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"both", " ", "parities"}], ",", " ", 
      RowBox[{"same", " ", "order", " ", "as", " ", "neweigenvec"}]}], ")"}], 
    " ", "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"quasienergies", " ", "=", " ", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"\"\<Even\>\"", ",", " ", "\"\<Phases\>\""}], "]"}], ",", " ", 
      RowBox[{"data", "[", 
       RowBox[{"\"\<Odd\>\"", ",", " ", "\"\<Phases\>\""}], "]"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.986635574700638*^9, 3.986635602586647*^9}, {
  3.986652009267206*^9, 3.986652009861374*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"93bc2a83-45f2-ed4a-ad8a-51e225854125"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s", " ", "=", " ", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"targets", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"p", " ", "*", " ", 
       RowBox[{"Pi", " ", "/", " ", "s"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"p", ",", " ", "0", ",", " ", 
        RowBox[{
         RowBox[{"2", "s"}], " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "wrap", " ", "distance", " ", "accounting", " ", "for", " ", "2", "\[Pi]", 
    " ", "periodicity"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"delta", " ", "=", " ", 
   RowBox[{"Map", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"#", " ", "-", " ", "targets"}], "]"}], "]"}], ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"#", " ", "-", " ", "targets", " ", "-", " ", 
           RowBox[{"2", "Pi"}]}], "]"}], "]"}], ",", " ", 
        RowBox[{"Min", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"#", " ", "-", " ", "targets", " ", "+", " ", 
           RowBox[{"2", "Pi"}]}], "]"}], "]"}]}], "]"}], " ", "&"}], ",", 
     "\n", "  ", "quasienergies"}], "\n", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.986637325228945*^9},
 CellLabel->"In[30]:=",ExpressionUUID->"95fd26be-374e-fe42-8ab7-dfac469aefc4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"quasienergies", ",", "delta"}], "}"}], "]"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{
      RowBox[{"PointSize", "[", "0.004", "]"}], ",", 
      RowBox[{"Opacity", "[", "0.6", "]"}], ",", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.8", ",", "0.2", ",", "0.2"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Quasienergy \[CurlyPhi]\>\"", ",", "16"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\[Delta] = min|\[CurlyPhi] - p\[Pi]/s|\>\"", ",", "16"}], 
       "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<Proximity to recurrence quasienergies  (s=\>\"", "<>", 
       RowBox[{"ToString", "[", "s", "]"}], "<>", "\"\<)\>\""}], ",", "14"}], 
     "]"}]}], ",", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"14", ",", "Black"}], "]"}]}], ",", 
   RowBox[{"ImageSize", "->", "700"}], ",", 
   RowBox[{"AspectRatio", "->", 
    RowBox[{"1", "/", "2"}]}], ",", 
   RowBox[{"Frame", "->", "True"}]}], "]"}]], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"66b20ec1-48e7-3849-9590-eccf32447d30"],

