Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\:2550\:2550", " ", "Parity", " ", "operator", " ", 
     RowBox[{"weights", "[", 
      RowBox[{
       RowBox[{"M", "'"}], "_s"}], "]"}], "_", 
     RowBox[{"{", "mm", "}"}], " ", 
     "\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550", " ", 
     RowBox[{"User", "'"}], "s", " ", 
     RowBox[{"convention", ":", 
      RowBox[{
       RowBox[{"lowest", "-", 
        RowBox[{"weight", " ", "reference", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"|", "J"}], ",", 
            RowBox[{"-", "J\:27e9"}]}], ")"}], ".", "The"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}], "^", "j"}], " ", "factor", " ", 
         "relabels", " ", "m"}]}], "\[RightArrow]", 
       RowBox[{
        RowBox[{"-", "m"}], " ", "relative", " ", "to", " ", "Koczor", " ", 
        "et", " ", 
        RowBox[{"al", ".", 
         RowBox[{"(", "2020", ")"}]}]}]}]}]}], ",", 
    RowBox[{"Eq", ".", 
     RowBox[{"(", "5", ")"}], "."}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "\:2550\:2550", " ", "Numerically", " ", "Stable", " ", "Parity", " ", 
    "Weights", " ", 
    "\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"generateParityWeights", "[", 
      RowBox[{"Jval_", ",", "sval_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Rsphere", ",", "logGammaList", ",", "gammaList", ",", "mList"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"Rsphere", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Jval", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "Pi"}], ")"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Shift", " ", "to", " ", "logarithmic", " ", "operations", " ", 
           "to", " ", "prevent", " ", "overflow", " ", "for", " ", "J"}], ">",
           "85"}], "*)"}], 
        RowBox[{"logGammaList", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Log", "[", "Rsphere", "]"}], "+", 
            RowBox[{"0.5", " ", 
             RowBox[{"Log", "[", 
              RowBox[{"4", " ", "Pi"}], "]"}]}], "+", 
            RowBox[{"LogGamma", "[", 
             RowBox[{
              RowBox[{"2", " ", "Jval"}], "+", "1"}], "]"}], "-", 
            RowBox[{"0.5", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"LogGamma", "[", 
                RowBox[{
                 RowBox[{"2", " ", "Jval"}], "+", "j", "+", "2"}], "]"}], "+", 
               RowBox[{"LogGamma", "[", 
                RowBox[{
                 RowBox[{"2", " ", "Jval"}], "-", "j", "+", "1"}], "]"}]}], 
              ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "0", ",", 
             RowBox[{"2", " ", "Jval"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gammaList", "=", 
         RowBox[{"Exp", "[", "logGammaList", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mList", "=", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "Jval"}], ",", "Jval"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"N", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "Rsphere"}], ")"}], " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "j"}], "*", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "j"}], "+", "1"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{"4", " ", "Pi"}], ")"}]}], "]"}], "*", 
               RowBox[{
                RowBox[{"gammaList", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "+", "1"}], "]"}], "]"}], "^", 
                RowBox[{"(", 
                 RowBox[{"-", "sval"}], ")"}]}], "*", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "j"}], "+", "1"}], ")"}], "/", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "Jval"}], "+", "1"}], ")"}]}], "]"}], "*", 
               RowBox[{"ClebschGordan", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"Jval", ",", "m"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"Jval", ",", "m"}], "}"}]}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "0", ",", 
                RowBox[{"2", " ", "Jval"}]}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "mList"}], "}"}]}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"\:2550\:2550", " ", "One"}], "-", 
      RowBox[{
      "time", " ", "J_y", " ", "diagonalization", " ", 
       "\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\:2550\
\:2550\:2550\:2550", " ", "Returns", " ", 
       RowBox[{"{", 
        RowBox[{"U", ",", "eigenvalues"}], "}"}], " ", "such", " ", "that", " ",
        "J_y"}]}], "=", 
     RowBox[{
      RowBox[{"U", ".", "diag"}], 
      RowBox[{
       RowBox[{"(", "eigenvalues", ")"}], ".", 
       RowBox[{"U", "^", "\[Dagger]"}], "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
